---
import Layout from '../layouts/Layout.astro';
import { apiGet } from '../lib/api';
import { renderPracticeQueue } from '../lib/practice-card';
import {
  isTypeActive,
  PRACTICE_TYPE_LABEL,
  PRACTICE_TYPES,
  parseTypesParam,
  toggleType,
  typesQuery,
} from '../lib/practice-filter';
import { getCurrentUser } from '../lib/session';
import type { PracticeQueueResponse } from '../lib/types';

const user = await getCurrentUser(Astro.request);
const activeTypes = parseTypesParam(Astro.url.searchParams.get('types'));
const filterQuery = typesQuery(activeTypes);
const queue: PracticeQueueResponse = user
  ? await apiGet<PracticeQueueResponse>(
      `/learning/practice?limit=20${filterQuery ? `&${filterQuery}` : ''}`,
      { request: Astro.request },
    )
  : { items: [], nextOffset: null, heldBackNewCount: 0, hasAnyCards: false };

const initialHtml = user ? renderPracticeQueue(queue, activeTypes) : '';
const chips = PRACTICE_TYPES.map((type) => {
  const next = typesQuery(toggleType(activeTypes, type));
  return {
    type,
    label: PRACTICE_TYPE_LABEL[type],
    active: isTypeActive(activeTypes, type),
    href: next ? `/practice?${next}` : '/practice',
  };
});
---

<Layout title="Practice — Engofy" user={user} active="practice">
  <h1>Practice</h1>

  {
    !user ? (
      <p>
        <a href="/login">Sign in</a> to build a deck and review it here.
      </p>
    ) : (
      <>
        {queue.hasAnyCards && (
          <nav class="practice__filter" aria-label="Тип карток">
            {chips.map((chip) => (
              <a
                href={chip.href}
                class:list={[
                  'practice__chip',
                  { 'practice__chip--on': chip.active },
                ]}
                aria-current={chip.active ? 'true' : undefined}
                data-testid={`practice-chip-${chip.type}`}
              >
                {chip.label}
              </a>
            ))}
          </nav>
        )}
        <div id="practice-container" set:html={initialHtml} />
      </>
    )
  }
</Layout>

<script>
  import '../lib/practice-client';
</script>

<style is:global>
  .practice__card,
  .practice__done {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 2rem 1.5rem;
    text-align: center;
    max-width: 32rem;
    margin: 1rem auto 0;
  }
  .practice__filter {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .practice__chip {
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    text-decoration: none;
  }
  .practice__chip--on {
    border-color: var(--color-brand-strong);
    color: var(--color-brand-strong);
    font-weight: 600;
  }
  .practice__key {
    margin-left: 0.25rem;
    padding: 0 0.3rem;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    font-family: inherit;
    font-size: 0.7rem;
    color: var(--color-ink-soft);
  }
  .practice__grade .practice__key {
    border-color: currentColor;
    color: inherit;
    opacity: 0.85;
  }
  .practice__count {
    margin: 0 0 1.5rem;
    font-size: 0.8rem;
    color: var(--color-ink-soft);
  }
  .practice__kicker {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-strong);
  }
  .practice__front {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
  }
  .practice__answer {
    margin: 0 0 1.5rem;
    color: var(--color-ink-soft);
  }
  .practice__answer--self {
    font-size: 0.85rem;
  }
  .practice__reveal {
    margin-bottom: 1.5rem;
  }
  .practice__phonetic {
    font-style: italic;
  }
  .practice__speak {
    margin-left: 0.35rem;
    padding: 0 0.25rem;
    font-size: 1rem;
    line-height: 1;
    vertical-align: middle;
  }
  .practice__example {
    margin: 0.5rem 0 0;
    font-style: italic;
  }
  .practice__more {
    font-size: 0.9rem;
  }
  .practice__context {
    margin: 0.5rem 0 0;
    padding: 0.5rem 0 0.5rem 1rem;
    border-left: 2px solid var(--color-border);
    text-align: left;
    font-size: 0.9rem;
  }
  .practice__context p {
    margin: 0 0 0.25rem;
  }
  .practice__context cite {
    font-size: 0.75rem;
    font-style: normal;
    color: var(--color-ink-soft);
  }
  .practice__grades {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .practice__done-emoji {
    font-size: 2rem;
    color: var(--color-success);
    margin: 0;
  }
</style>
