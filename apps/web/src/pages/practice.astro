---
import Layout from '../layouts/Layout.astro';
import { apiGet } from '../lib/api';
import { renderPracticeQueue } from '../lib/practice-card';
import { getCurrentUser } from '../lib/session';
import type { PracticeQueueResponse } from '../lib/types';

const user = await getCurrentUser(Astro.request);
const queue: PracticeQueueResponse = user
  ? await apiGet<PracticeQueueResponse>('/learning/practice?limit=20', {
      request: Astro.request,
    })
  : { items: [], nextOffset: null, heldBackNewCount: 0 };

const initialHtml = user ? renderPracticeQueue(queue) : '';
---

<Layout title="Practice — Engofy" user={user} active="practice">
  <h1>Practice</h1>

  {
    !user ? (
      <p>
        <a href="/login">Sign in</a> to build a deck and review it here.
      </p>
    ) : (
      <div id="practice-container" set:html={initialHtml} />
    )
  }
</Layout>

<script is:inline>
  // "Show answer" toggle, delegated so it survives HTMX swaps of the card.
  document.addEventListener('click', (e) => {
    const revealBtn = e.target.closest('.practice__reveal');
    if (revealBtn) {
      const answer = revealBtn.parentElement?.querySelector('.practice__answer');
      if (answer) {
        answer.hidden = false;
        revealBtn.hidden = true;
      }
      return;
    }

    // 🔊 pronunciation, client-side only (Web Speech API) — no audio asset.
    const speakBtn = e.target.closest('.practice__speak');
    if (speakBtn && 'speechSynthesis' in window) {
      const text = speakBtn.dataset.speak;
      if (text) {
        window.speechSynthesis.cancel();
        window.speechSynthesis.speak(new SpeechSynthesisUtterance(text));
      }
    }
  });
</script>

<style is:global>
  .practice__card,
  .practice__done {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 2rem 1.5rem;
    text-align: center;
    max-width: 32rem;
    margin: 1rem auto 0;
  }
  .practice__count {
    margin: 0 0 1.5rem;
    font-size: 0.8rem;
    color: var(--color-ink-soft);
  }
  .practice__kicker {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-strong);
  }
  .practice__front {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
  }
  .practice__answer {
    margin: 0 0 1.5rem;
    color: var(--color-ink-soft);
  }
  .practice__answer--self {
    font-size: 0.85rem;
  }
  .practice__reveal {
    margin-bottom: 1.5rem;
  }
  .practice__phonetic {
    font-style: italic;
  }
  .practice__speak {
    margin-left: 0.35rem;
    padding: 0 0.25rem;
    font-size: 1rem;
    line-height: 1;
    vertical-align: middle;
  }
  .practice__context {
    margin: 0.5rem 0 0;
    padding: 0.5rem 0 0.5rem 1rem;
    border-left: 2px solid var(--color-border);
    text-align: left;
    font-size: 0.9rem;
  }
  .practice__context p {
    margin: 0 0 0.25rem;
  }
  .practice__context cite {
    font-size: 0.75rem;
    font-style: normal;
    color: var(--color-ink-soft);
  }
  .practice__grades {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .practice__done-emoji {
    font-size: 2rem;
    color: var(--color-success);
    margin: 0;
  }
</style>
