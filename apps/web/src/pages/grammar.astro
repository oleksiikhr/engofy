---
import Layout from '../layouts/Layout.astro';
import { apiGet } from '../lib/api';
import {
  GRAMMAR_CEFR_LEVELS,
  GRAMMAR_GROUP_BY,
  GRAMMAR_GROUP_BY_LABEL,
  GRAMMAR_STATE_LABEL,
  parseGrammarQuery,
  toGrammarApiQuery,
} from '../lib/grammar-list';
import { getCurrentUser } from '../lib/session';
import type { EffectiveState, GrammarReference } from '../lib/types';

const user = await getCurrentUser(Astro.request);
const query = parseGrammarQuery(Astro.url.searchParams);

const ref = await apiGet<GrammarReference>(
  `/content/grammar?${toGrammarApiQuery(query)}`,
  { request: Astro.request },
);

// New has no tag, so it needs no tone.
const STATE_TONE: Record<Exclude<EffectiveState, 'new'>, string> = {
  learning: 'tone-brand',
  learned: 'tone-green',
  skipped: 'tone-amber',
};

const groups = ref.groups.filter((g) => g.constructions.length > 0);
---

<Layout title="Grammar — Engofy" user={user} active="grammar">
  <h1>Grammar reference</h1>
  <p class="grammar-intro">
    The Cambridge English Grammar Profile — filter by the levels you're working
    on and group the list the way that helps you most.
  </p>

  <form
    id="grammar-filters"
    method="get"
    action="/grammar"
    hx-get="/grammar"
    hx-target="#grammar-results"
    hx-select="#grammar-results"
    hx-swap="outerHTML"
    hx-push-url="true"
    hx-trigger="change, submit"
    class="grammar-controls"
  >
    <fieldset class="grammar-pills" data-testid="grammar-levels">
      <legend class="eyebrow">Level</legend>
      {
        GRAMMAR_CEFR_LEVELS.map((level) => (
          <label class="pill">
            <input
              type="checkbox"
              name="cefr"
              value={level}
              checked={query.cefr.includes(level)}
            />
            <span>{level}</span>
          </label>
        ))
      }
    </fieldset>

    <fieldset class="grammar-pills" data-testid="grammar-group-by">
      <legend class="eyebrow">Group by</legend>
      {
        GRAMMAR_GROUP_BY.map((axis) => (
          <label class="pill">
            <input
              type="radio"
              name="groupBy"
              value={axis}
              checked={query.groupBy === axis}
            />
            <span>{GRAMMAR_GROUP_BY_LABEL[axis]}</span>
          </label>
        ))
      }
    </fieldset>

    <noscript><button class="btn" type="submit">Apply</button></noscript>
  </form>

  <div id="grammar-results">
    {
      groups.length === 0 && (
        <div class="card card--soft grammar-empty" data-testid="grammar-empty">
          <p>No constructions at this level yet.</p>
        </div>
      )
    }
    {
      groups.map((group) => (
        <section class="grammar-cat" data-group={group.key}>
          <h2>{group.name}</h2>
          <ul class="grammar-cons">
            {group.constructions.map((con) => (
              <li>
                <a
                  href={`/grammar/${con.slug}`}
                  class="grammar-con card"
                  data-state={con.state}
                >
                  <span class="grammar-con__head">
                    {con.cefrLevel && <span class="badge">{con.cefrLevel}</span>}
                    {con.state !== 'new' && (
                      <span
                        class={`tag grammar-con__state ${STATE_TONE[con.state]}`}
                      >
                        {GRAMMAR_STATE_LABEL[con.state]}
                      </span>
                    )}
                  </span>
                  <span class="grammar-con__name">{con.name}</span>
                  <span class="grammar-con__count meta">
                    {con.usagePointCount} use{con.usagePointCount === 1 ? '' : 's'}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .grammar-intro {
    color: var(--color-ink-soft);
    margin: 0 0 1.25rem;
  }
  .grammar-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem 2rem;
    margin-bottom: 2rem;
  }
  .grammar-pills {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .grammar-pills legend {
    float: left;
    padding: 0;
    margin-right: 0.25rem;
  }
  .grammar-empty {
    color: var(--color-ink-soft);
    text-align: center;
  }
  .grammar-empty p {
    margin: 0;
  }
  .grammar-cat {
    margin-bottom: 2rem;
  }
  .grammar-cat h2 {
    margin-bottom: 0.75rem;
    font-size: 1.19rem;
    font-weight: 800;
  }
  .grammar-cons {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.875rem;
  }
  .grammar-con {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1rem 1.125rem;
    text-decoration: none;
    color: var(--color-ink);
  }
  .grammar-con:hover {
    border-color: var(--color-brand);
    color: var(--color-ink);
  }
  .grammar-con:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .grammar-con[data-state='learning'] {
    border-color: var(--color-brand);
    background: var(--color-brand-wash);
  }
  .grammar-con[data-state='skipped'] {
    color: var(--color-ink-soft);
  }
  .grammar-con__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .grammar-con__state {
    margin-left: auto;
  }
  .grammar-con__name {
    font-weight: 800;
    line-height: 1.3;
  }
  .grammar-con__count {
    margin-top: auto;
    font-size: 0.8rem;
  }
</style>
