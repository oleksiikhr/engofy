---
import Layout from '../layouts/Layout.astro';
import { apiGet } from '../lib/api';
import {
  GRAMMAR_CEFR_LEVELS,
  GRAMMAR_GROUP_BY,
  GRAMMAR_GROUP_BY_LABEL,
  GRAMMAR_STATE_LABEL,
  parseGrammarQuery,
  toGrammarApiQuery,
} from '../lib/grammar-list';
import { getCurrentUser } from '../lib/session';
import type { GrammarReference } from '../lib/types';

const user = await getCurrentUser(Astro.request);
const query = parseGrammarQuery(Astro.url.searchParams);

const ref = await apiGet<GrammarReference>(
  `/content/grammar?${toGrammarApiQuery(query)}`,
  { request: Astro.request },
);

const groups = ref.groups.filter((g) => g.constructions.length > 0);
---

<Layout title="Grammar — Engofy" user={user} active="grammar">
  <h1>Grammar reference</h1>
  <p class="grammar-intro">
    The Cambridge English Grammar Profile — filter by the levels you're working
    on and group the list the way that helps you most.
  </p>

  <form
    id="grammar-filters"
    method="get"
    action="/grammar"
    hx-get="/grammar"
    hx-target="#grammar-results"
    hx-select="#grammar-results"
    hx-swap="outerHTML"
    hx-push-url="true"
    hx-trigger="change, submit"
    class="grammar-controls"
  >
    <fieldset class="grammar-chips" data-testid="grammar-levels">
      <legend>Level</legend>
      {
        GRAMMAR_CEFR_LEVELS.map((level) => (
          <label class="grammar-chip">
            <input
              type="checkbox"
              name="cefr"
              value={level}
              checked={query.cefr.includes(level)}
            />
            <span>{level}</span>
          </label>
        ))
      }
    </fieldset>

    <fieldset class="grammar-chips" data-testid="grammar-group-by">
      <legend>Group by</legend>
      {
        GRAMMAR_GROUP_BY.map((axis) => (
          <label class="grammar-chip">
            <input
              type="radio"
              name="groupBy"
              value={axis}
              checked={query.groupBy === axis}
            />
            <span>{GRAMMAR_GROUP_BY_LABEL[axis]}</span>
          </label>
        ))
      }
    </fieldset>

    <noscript><button class="btn" type="submit">Apply</button></noscript>
  </form>

  <div id="grammar-results">
    {
      groups.length === 0 && (
        <p data-testid="grammar-empty">No constructions at this level yet.</p>
      )
    }
    {
      groups.map((group) => (
        <section class="grammar-cat" data-group={group.key}>
          <h2>{group.name}</h2>
          <ul class="grammar-cons">
            {group.constructions.map((con) => (
              <li>
                <a
                  href={`/grammar/${con.slug}`}
                  class={`grammar-con grammar-con--${con.state}`}
                  data-state={con.state}
                >
                  {con.cefrLevel && <span class="badge">{con.cefrLevel}</span>}
                  <span class="grammar-cons__name">{con.name}</span>
                  {con.state !== 'new' && (
                    <span class="grammar-cons__state">
                      {GRAMMAR_STATE_LABEL[con.state]}
                    </span>
                  )}
                  <span class="grammar-cons__count">
                    {con.usagePointCount} use{con.usagePointCount === 1 ? '' : 's'}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .grammar-intro {
    color: var(--color-ink-soft);
    margin-bottom: 1rem;
  }
  .grammar-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .grammar-chips {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    border: 0;
    margin: 0;
    padding: 0;
  }
  .grammar-chips legend {
    float: left;
    padding: 0;
    margin-right: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-ink-soft);
  }
  .grammar-chip {
    cursor: pointer;
  }
  .grammar-chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .grammar-chip span {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    font-size: 0.85rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-ink-soft);
  }
  .grammar-chip input:checked + span {
    background: var(--color-brand-wash);
    border-color: var(--color-brand);
    color: var(--color-brand-strong);
    font-weight: 600;
  }
  .grammar-chip input:focus-visible + span {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }
  .grammar-cat {
    margin-bottom: 1.75rem;
  }
  .grammar-cons {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .grammar-cons a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border);
    border-left-width: 3px;
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--color-ink);
  }
  .grammar-cons a:hover {
    border-color: var(--color-brand);
  }
  .grammar-con--learning {
    border-left-color: var(--color-brand);
    background: var(--color-brand-wash);
  }
  .grammar-con--learned {
    border-left-color: var(--color-success);
  }
  .grammar-con--skipped {
    border-left-color: var(--color-warning);
    color: var(--color-ink-soft);
  }
  .grammar-cons__name {
    font-weight: 600;
  }
  .grammar-cons__state {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .grammar-con--learned .grammar-cons__state {
    color: var(--color-success);
  }
  .grammar-con--skipped .grammar-cons__state {
    color: var(--color-warning);
  }
  .grammar-cons__count {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--color-ink-soft);
  }
</style>
