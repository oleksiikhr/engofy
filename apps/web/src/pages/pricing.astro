---
import Layout from '../layouts/Layout.astro';
import { apiGet, apiPost } from '../lib/api';
import { getCurrentUser } from '../lib/session';
import type { Subscription } from '../lib/types';

const FREE_LIMIT = 100;
const user = await getCurrentUser(Astro.request);

let sub: Subscription | null = user
  ? await apiGet<Subscription>('/billing/subscription', {
      request: Astro.request,
    })
  : null;
let justUpgraded = false;
let error: string | null = null;

if (Astro.request.method === 'POST' && user) {
  const form = await Astro.request.formData();
  if (form.get('action') === 'subscribe') {
    try {
      sub = await apiPost<Subscription>('/billing/subscribe', undefined, {
        request: Astro.request,
      });
      justUpgraded = true;
    } catch {
      error = 'Could not start the subscription — please try again.';
    }
  }
}

const isPremium = sub?.plan === 'premium' && sub.active;
const renews = sub?.currentPeriodEnd
  ? new Date(sub.currentPeriodEnd).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null;
---

<Layout title="Pricing — Engofy" user={user} active="pricing">
  <div class="pricing">
    <header class="pricing__head">
      <h1>Go further with Premium</h1>
      <p>Everything you need to read and learn is free. Premium lifts the limit on saved cards.</p>
    </header>

    {
      error && (
        <p class="alert tone-danger" role="alert">
          {error}
        </p>
      )
    }
    {
      justUpgraded && (
        <p class="alert tone-green" role="status">
          You're on Premium{renews ? ` until ${renews}` : ''}. Enjoy unlimited
          cards!
        </p>
      )
    }

    <div class="plans">
      <section class="card plan">
        <h2>Free</h2>
        <p class="plan__price num">$0</p>
        <ul class="plan__list">
          <li>Every article, tooltip and exercise</li>
          <li>Grammar reference for every construction</li>
          <li>Up to {FREE_LIMIT} saved cards</li>
        </ul>
      </section>

      <section class:list={['card', 'card--hi', 'plan', { 'plan--current': isPremium }]}>
        <h2>Premium <span class="badge badge--solid">Best value</span></h2>
        <p class="plan__price num">$4.99<span>/month</span></p>
        <ul class="plan__list">
          <li><strong>Unlimited</strong> saved cards</li>
          <li>Everything in Free</li>
          <li>Supports the project</li>
        </ul>

        {
          isPremium ? (
            <p class="plan__state" data-testid="premium-active">
              Active{renews ? ` — renews ${renews}` : ''}
            </p>
          ) : user ? (
            <form method="post">
              <input type="hidden" name="action" value="subscribe" />
              <button class="btn btn--lg" type="submit">
                Upgrade to Premium
              </button>
              <p class="plan__note">
                Mock checkout — no card required, no real charge (PLAN §8).
              </p>
            </form>
          ) : (
            <a class="btn btn--lg" href="/login">
              Sign in to upgrade
            </a>
          )
        }
      </section>
    </div>
  </div>
</Layout>

<style>
  .pricing {
    max-width: 46rem;
    margin: 0 auto;
  }
  .pricing__head {
    text-align: center;
    margin-bottom: 2rem;
  }
  .pricing__head p {
    margin: 0;
    color: var(--color-ink-soft);
  }
  .pricing .alert {
    margin: 0 0 1.5rem;
    font-weight: 700;
  }
  .plans {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .plans {
      grid-template-columns: 1fr 1fr;
    }
  }
  .plan {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
  }
  .plan h2 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
  }
  .plan--current {
    background: var(--color-brand-wash);
  }
  .plan__price {
    margin: 0.5rem 0 1rem;
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.1;
  }
  .plan__price span {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-ink-faint);
  }
  .plan__list {
    flex: 1;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }
  .plan__list li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--color-ink-soft);
  }
  .plan__list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    font-weight: 800;
    color: var(--color-success-ink);
  }
  .plan__state {
    margin: 0;
    font-weight: 800;
    color: var(--color-brand-strong);
  }
  .plan form {
    display: grid;
  }
  .plan__note {
    margin: 0.6rem 0 0;
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-ink-faint);
  }
</style>
