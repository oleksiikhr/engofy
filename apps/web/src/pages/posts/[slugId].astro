---
import Layout from '../../layouts/Layout.astro';
import { apiGetOrNull } from '../../lib/api';
import { buildLexiconData } from '../../lib/lexicon-data';
import { renderDoc } from '../../lib/render-doc';
import { getCurrentUser } from '../../lib/session';
import type {
  NewCardBudgetResponse,
  PostDetail,
  PracticeQueueResponse,
} from '../../lib/types';

const { slugId } = Astro.params;
const user = await getCurrentUser(Astro.request);
const post = slugId
  ? await apiGetOrNull<PostDetail>(
      `/content/posts/${encodeURIComponent(slugId)}`,
      { request: Astro.request },
    )
  : null;

if (!post) {
  return new Response('Not found', { status: 404 });
}

const published = new Date(post.publishedAt).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const bodyHtml = renderDoc(post.doc, post.annotations);
// `<` is escaped so the JSON can't close its own <script> element.
const escapeJson = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
const lexicon = buildLexiconData(post.annotations, post.exercises);
const lexiconJson = escapeJson(lexicon);
// `?? []`: an API still on the previous release omits `tokens`.
const tokens = post.annotations.tokens ?? [];
const tokensJson = escapeJson(tokens);

// --- exercise view models (all casts / normalisation live here; the template
// only maps over plain data) ---
type Ex = PostDetail['exercises'][number];

function splitBlank(prompt: string): { before: string; after: string } {
  const i = prompt.indexOf('____');
  return i === -1
    ? { before: prompt, after: '' }
    : { before: prompt.slice(0, i), after: prompt.slice(i + 4) };
}

interface DrillView {
  id: string;
  type: 'fill_blank' | 'multiple_choice' | 'find_error' | 'reorder';
  before: string;
  after: string;
  prompt: string;
  answer: string;
  answerIndex: number;
  options: string[];
  scrambled: string[];
  order: number[];
}

function toDrill(ex: Ex): DrillView | null {
  const p = ex.payload as Record<string, unknown>;
  const base = {
    id: ex.id,
    before: '',
    after: '',
    prompt: '',
    answer: '',
    answerIndex: -1,
    options: [] as string[],
    scrambled: [] as string[],
    order: [] as number[],
  };
  if (ex.type === 'fill_blank') {
    const { before, after } = splitBlank(String(p.prompt ?? ''));
    return {
      ...base,
      type: 'fill_blank',
      before,
      after,
      answer: String(p.answer ?? ''),
      // `payload` is untyped; the word bank is empty when there are too few distractors.
      options: Array.isArray(p.options) ? (p.options as string[]) : [],
    };
  }
  if (ex.type === 'multiple_choice') {
    const { before, after } = splitBlank(String(p.prompt ?? ''));
    return {
      ...base,
      type: 'multiple_choice',
      before,
      after,
      options: Array.isArray(p.options) ? (p.options as string[]) : [],
      answerIndex: Number(p.answerIndex ?? -1),
    };
  }
  if (ex.type === 'find_error') {
    return {
      ...base,
      type: 'find_error',
      prompt: String(p.prompt ?? ''),
      answer: String(p.correction ?? ''),
    };
  }
  if (ex.type === 'reorder') {
    return {
      ...base,
      type: 'reorder',
      scrambled: Array.isArray(p.scrambled) ? (p.scrambled as string[]) : [],
      order: Array.isArray(p.answer) ? (p.answer as number[]) : [],
    };
  }
  return null;
}

// --- final screen ---
interface ContrastView {
  before: string;
  after: string;
  options: string[];
  answerIndex: number;
  explanations: string[];
}

// Only constructions still marked for this viewer (new/learning) get a
// question; none marked -> no block at all.
function toContrast(ex: Ex): ContrastView | null {
  const p = ex.payload as Record<string, unknown>;
  const pointId = p.grammarUsagePointId;
  if (
    ex.type !== 'grammar_contrastive' ||
    typeof pointId !== 'string' ||
    !lexicon.grammar[pointId] ||
    typeof p.question !== 'string' ||
    !Array.isArray(p.options)
  ) {
    return null;
  }
  const { before, after } = splitBlank(p.question);
  return {
    before,
    after,
    options: p.options as string[],
    answerIndex: Number(p.answerIndex ?? -1),
    explanations: Array.isArray(p.optionExplanations)
      ? (p.optionExplanations as string[])
      : [],
  };
}

const MAX_FINAL_QUESTIONS = 2;
const contrastQuestions = post.exercises
  .map(toContrast)
  .filter((q): q is ContrastView => q !== null)
  .slice(0, MAX_FINAL_QUESTIONS);

const newWordCount = Object.values(lexicon.words).filter(
  (w) => w.state === 'new',
).length;
const grammarCount = Object.keys(lexicon.grammar).length;
const summaryParts = [
  newWordCount > 0 && `${newWordCount} new word${newWordCount === 1 ? '' : 's'}`,
  grammarCount > 0 &&
    `${grammarCount} grammar pattern${grammarCount === 1 ? '' : 's'}`,
].filter(Boolean);

// Both are best-effort, signed-in only: an API on the previous release lacks
// the budget route, and neither may take the page down.
const [budget, dueCards] = user
  ? await Promise.all([
      apiGetOrNull<NewCardBudgetResponse>('/learning/new-card-budget', {
        request: Astro.request,
      }).catch(() => null),
      apiGetOrNull<PracticeQueueResponse>(
        `/learning/posts/${encodeURIComponent(slugId ?? '')}/due-cards`,
        { request: Astro.request },
      ).catch(() => null),
    ])
  : [null, null];
const dueCount = dueCards?.items.length ?? 0;
// The Home session sends the learner here with ?from=home and its next step
// (today's practice) lives on Home.
const fromHome = Astro.url.searchParams.get('from') === 'home';

const drills: DrillView[] = post.exercises
  .map(toDrill)
  .filter((d): d is DrillView => d !== null);
---

<Layout
  title={`${post.title ?? 'Reading'} — Engofy`}
  user={user}
  active="posts"
>
  <div class="reader-layout" data-slug-id={slugId} data-new-budget={budget?.remaining}>
    <article class="reader-article">
      <header class="post-head">
        <a class="post-head__back meta" href="/posts">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
          Posts
        </a>
        <div class="post-head__meta">
          {post.cefrLevel && <span class="badge">{post.cefrLevel}</span>}
          <time datetime={post.publishedAt}>{published}</time>
        </div>
        <h1>{post.title ?? 'Untitled'}</h1>
        {
          (post.sourceType !== 'original' || post.sourceLink) && (
            <p class="post-head__source">
              {post.sourceType !== 'original' && <span>{post.attributionText}</span>}
              {post.sourceLink && (
                <>
                  {post.sourceType !== 'original' ? ' — ' : 'Source: '}
                  <a
                    href={post.sourceLink}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {post.sourceLink}
                  </a>
                </>
              )}
            </p>
          )
        }
      </header>

      <div class="reader-toolbar" role="toolbar" aria-label="Reader tools">
        {
          tokens.length > 0 && (
            <>
              <button type="button" class="reader-toolbar__btn tone-green" data-mode="pos" aria-pressed="false">
                <b aria-hidden="true">Aa</b>Word types
              </button>
              <button type="button" class="reader-toolbar__btn tone-blue" data-mode="tense" aria-pressed="false">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 8v4l2.5 2.5" /></svg>Tenses
              </button>
              <button type="button" class="reader-toolbar__btn tone-pink" data-mode="analyze" aria-pressed="false">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="M20 20l-5.5-5.5" /></svg>Analyze
              </button>
            </>
          )
        }
        <button type="button" class="reader-toolbar__btn tone-amber" data-study-toggle aria-pressed="false">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4l13 8-13 8V4z" /></svg>Study mode
        </button>
        <span class="reader-toolbar__size">
          <button type="button" class="reader-toolbar__btn reader-toolbar__step" data-size="-1" aria-label="Smaller text">A−</button>
          <button type="button" class="reader-toolbar__btn reader-toolbar__step" data-size="1" aria-label="Larger text">A+</button>
        </span>
        <div class="reader-legend" data-legend="pos" hidden>
          <span class="reader-legend__item tone-blue" data-pos-group="noun">noun</span>
          <span class="reader-legend__item tone-brand" data-pos-group="verb">verb</span>
          <span class="reader-legend__item tone-green" data-pos-group="adj">adjective</span>
          <span class="reader-legend__item tone-pink" data-pos-group="adv">adverb</span>
          <label class="reader-legend__switch">
            <span class="reader-legend__sample" data-pos-group="fn">the</span>
            Function words
            <input type="checkbox" class="toggle toggle--sm" role="switch" data-function-words />
          </label>
        </div>
        <p class="reader-legend" data-legend="tense" hidden>
          <span class="reader-legend__item tone-amber" data-tense="past">past</span>
          <span class="reader-legend__item tone-blue" data-tense="present">present</span>
          <span class="reader-legend__item tone-green" data-tense="future">future</span>
        </p>
        <p class="reader-legend" data-legend="analyze" hidden>
          Tap a highlighted construction to see why it fits. Irregular verbs show their forms.
        </p>
      </div>

      <div class="analysis reading-body" set:html={bodyHtml} />
      <script is:inline type="application/json" id="lexicon-data" set:html={lexiconJson} />
      <script is:inline type="application/json" id="reader-tokens" set:html={tokensJson} />
    </article>
  </div>

  <section class="reader-final" data-reader-final aria-label="Finished reading">
    <h2>Nice work — you finished this text</h2>
    {
      contrastQuestions.length > 0 && (
        <div class="final-questions">
          <p class="final-questions__lead">Two forms, one right here — which fits?</p>
          {contrastQuestions.map((q) => (
            <div class="final-q" data-contrast-q data-answer-index={String(q.answerIndex)}>
              <p class="final-q__prompt">{q.before}<b>____</b>{q.after}</p>
              <div class="final-q__options">
                {q.options.map((opt, i) => (
                  <button type="button" class="exercise__chip" data-option={String(i)}>
                    {opt}
                  </button>
                ))}
              </div>
              {q.explanations.map((text, i) => (
                <p class="final-q__explanation" data-explanation={String(i)} hidden>{text}</p>
              ))}
              <span class="final-q__result" role="status" />
            </div>
          ))}
        </div>
      )
    }
    <p class="final-summary">
      {
        summaryParts.length > 0
          ? `This text had ${summaryParts.join(' and ')} to learn.`
          : 'This text had nothing new for your level.'
      }<span data-added></span>
    </p>
    <p class="final-cta">
      {
        fromHome && user && (
          <a class="btn" href="/">Continue to today's practice</a>
        )
      }
      {
        !fromHome && dueCount > 0 && (
          <a class="btn" href="/practice">
            Practice {dueCount} card{dueCount === 1 ? '' : 's'} from this text
          </a>
        )
      }
      <a class="btn btn--ghost" href="/posts">More articles</a>
    </p>
  </section>

  {
    drills.length > 0 && (
      <section class="exercises">
        <h2>Practice</h2>
        {drills.map((d) => (
          <div class="exercise" data-ex-type={d.type} data-answer={d.answer} data-answer-index={String(d.answerIndex)} data-order={JSON.stringify(d.order)}>
            {d.type === 'fill_blank' && (
              <>
                <p class="exercise__q">
                  {d.before}
                  <input class="exercise__blank" type="text" aria-label="Missing word" />
                  {d.after}
                </p>
                {d.options.length > 0 && (
                  <div class="exercise__chips exercise__bank">
                    {d.options.map((opt) => (
                      <button type="button" class="exercise__chip exercise__bank-chip">
                        {opt}
                      </button>
                    ))}
                  </div>
                )}
              </>
            )}
            {d.type === 'multiple_choice' && (
              <>
                <p class="exercise__q">{d.before}<b>____</b>{d.after}</p>
                <ul class="exercise__options">
                  {d.options.map((opt, i) => (
                    <li>
                      <label>
                        <input type="radio" name={`mc-${d.id}`} value={String(i)} />
                        {opt}
                      </label>
                    </li>
                  ))}
                </ul>
              </>
            )}
            {d.type === 'find_error' && (
              <>
                <p class="exercise__hint">One word is in the wrong form. Type the correct form.</p>
                <p class="exercise__q">{d.prompt}</p>
                <input class="exercise__blank" type="text" aria-label="Correct form" />
              </>
            )}
            {d.type === 'reorder' && (
              <>
                <p class="exercise__hint">Put the words in order.</p>
                <div class="exercise__chips">
                  {d.scrambled.map((tok, slot) => (
                    <button type="button" class="exercise__chip" data-slot={String(slot)}>
                      {tok}
                    </button>
                  ))}
                </div>
                <p class="exercise__build" aria-live="polite" />
                <button class="btn btn--ghost exercise__reset" type="button">Reset</button>
              </>
            )}
            {d.type !== 'reorder' && (
              <button class="btn btn--ghost exercise__check" type="button">Check</button>
            )}
            <span class="exercise__result" role="status" />
          </div>
        ))}
      </section>
    )
  }
</Layout>

<script>
  import type { LexiconData } from '../../lib/reader-lexicon';
  import { initReaderFinal } from '../../lib/reader-final';
  import { initReaderPopup } from '../../lib/reader-popup';
  import { initReaderStudy } from '../../lib/reader-study';
  import { initReaderToolbar } from '../../lib/reader-toolbar';

  const body = document.querySelector<HTMLElement>('.reading-body');
  const raw = document.getElementById('lexicon-data')?.textContent;
  const lexicon: LexiconData | null = raw ? JSON.parse(raw) : null;
  if (body && lexicon) {
    initReaderPopup(body, lexicon);
  }
  const toolbar = document.querySelector<HTMLElement>('.reader-toolbar');
  const tokensRaw = document.getElementById('reader-tokens')?.textContent;
  if (body && toolbar && tokensRaw) {
    initReaderToolbar(toolbar, body, JSON.parse(tokensRaw));
  }

  const layout = document.querySelector<HTMLElement>('.reader-layout');
  const final = document.querySelector<HTMLElement>('[data-reader-final]');
  if (layout && final) {
    initReaderFinal(final, layout.dataset.slugId ?? '');
  }
  const studyToggle = toolbar?.querySelector<HTMLElement>('[data-study-toggle]');
  if (body && lexicon && studyToggle && final) {
    const budget = layout?.dataset.newBudget;
    initReaderStudy({
      root: body,
      toggle: studyToggle,
      lexicon,
      budget: budget === undefined ? null : Number(budget),
      onFinish: (detail) =>
        final.dispatchEvent(new CustomEvent('reader:finish', { detail })),
    });
  }
</script>

<script is:inline>
  (() => {
    const norm = (s) => String(s ?? '').trim().toLowerCase();
    function setResult(box, ok) {
      const r = box.querySelector('.exercise__result');
      if (!r) return;
      r.textContent = ok ? '✓ Correct' : '✗ Try again';
      r.className = `exercise__result ${ok ? 'is-ok' : 'is-bad'}`;
    }

    for (const box of document.querySelectorAll('.exercise')) {
      const type = box.getAttribute('data-ex-type');

      if (type === 'reorder') {
        const order = JSON.parse(box.getAttribute('data-order') || '[]');
        const build = box.querySelector('.exercise__build');
        const picks = [];
        box.querySelectorAll('.exercise__chip').forEach((chip) => {
          chip.addEventListener('click', () => {
            if (chip.disabled) return;
            chip.disabled = true;
            picks.push({
              slot: Number(chip.getAttribute('data-slot')),
              tok: chip.textContent.trim(),
            });
            build.textContent = picks.map((p) => p.tok).join(' ');
            const seq = picks.map((p) => order[p.slot]);
            if (seq.length === order.length) {
              setResult(box, seq.every((v, i) => v === i));
            }
          });
        });
        box.querySelector('.exercise__reset')?.addEventListener('click', () => {
          picks.length = 0;
          build.textContent = '';
          box
            .querySelectorAll('.exercise__chip')
            .forEach((c) => (c.disabled = false));
          const r = box.querySelector('.exercise__result');
          if (r) {
            r.textContent = '';
            r.className = 'exercise__result';
          }
        });
        continue;
      }

      box.querySelectorAll('.exercise__bank-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          const input = box.querySelector('.exercise__blank');
          if (input) input.value = chip.textContent.trim();
        });
      });

      const check = box.querySelector('.exercise__check');
      if (!check) continue;
      check.addEventListener('click', () => {
        if (type === 'fill_blank' || type === 'find_error') {
          const input = box.querySelector('.exercise__blank');
          setResult(box, norm(input?.value) === norm(box.getAttribute('data-answer')));
        } else if (type === 'multiple_choice') {
          const sel = box.querySelector('input[type=radio]:checked');
          setResult(
            box,
            sel != null && sel.value === box.getAttribute('data-answer-index'),
          );
        }
      });
    }
  })();
</script>

<style>
  .post-head {
    margin-bottom: 1.5rem;
  }
  .post-head__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1rem;
    text-decoration: none;
  }
  .post-head__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink-faint);
    margin-bottom: 0.75rem;
  }
  .post-head__source {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink-faint);
    word-break: break-all;
  }
  .post-head h1 {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .reading-body {
    font-size: var(--reader-font-size);
    line-height: 1.85;
  }
  /* Labelled words/phrases (amber chip) and grammar matches (blue chip). The
     spans come from set:html, so the selectors must be :global. */
  .reading-body :global([data-word-definition-id]),
  .reading-body :global([data-phrase-id]),
  .reading-body :global([data-grammar-usage-point-id]) {
    padding: 1px 6px;
    border-radius: 0.5rem;
    color: var(--color-ink);
    font-weight: 700;
    cursor: pointer;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .reading-body :global([data-word-definition-id]),
  .reading-body :global([data-phrase-id]) {
    background: var(--color-word);
  }
  .reading-body :global([data-grammar-usage-point-id]) {
    background: var(--color-gram);
  }
  .reading-body :global(.is-active) {
    outline: 2px solid var(--color-brand);
    outline-offset: 1px;
  }
  .reader-article {
    min-width: 0;
  }
  .exercises {
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }
  .exercise {
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-paper-soft);
    padding: 1.1rem 1.25rem;
    margin-bottom: 1rem;
  }
  .exercise__hint,
  .exercise__q {
    margin: 0 0 0.6rem;
  }
  .exercise__hint {
    font-size: 0.8rem;
    color: var(--color-ink-soft);
  }
  .exercise__blank {
    font: inherit;
    padding: 0.15rem 0.4rem;
    border: 2px solid var(--color-border-strong);
    border-radius: 0.5rem;
    background: var(--color-paper);
    color: inherit;
    min-width: 6rem;
  }
  .exercise__options {
    list-style: none;
    padding: 0;
    margin: 0 0 0.6rem;
  }
  .exercise__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
  }
  .exercise__chip {
    font: inherit;
    padding: 0.25rem 0.55rem;
    border: 2px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-paper);
    color: inherit;
    cursor: pointer;
  }
  .exercise__chip:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .exercise__build {
    min-height: 1.4rem;
    font-weight: 600;
    margin: 0 0 0.6rem;
  }
  .exercise__result {
    margin-left: 0.6rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .exercise__result.is-ok {
    color: var(--color-success);
  }
  .exercise__result.is-bad {
    color: var(--color-danger);
  }
</style>
