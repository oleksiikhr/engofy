---
import Layout from '../../layouts/Layout.astro';
import { apiGetOrNull } from '../../lib/api';
import { renderDoc } from '../../lib/render-doc';
import { getCurrentUser } from '../../lib/session';
import type { CardState, CefrLevel, PostDetail } from '../../lib/types';

const { slugId } = Astro.params;
const user = await getCurrentUser(Astro.request);
const post = slugId
  ? await apiGetOrNull<PostDetail>(
      `/content/posts/${encodeURIComponent(slugId)}`,
      { request: Astro.request },
    )
  : null;

if (!post) {
  return new Response('Not found', { status: 404 });
}

const published = new Date(post.publishedAt).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const bodyHtml = renderDoc(post.doc);

// --- "In this article" sidebar (PLAN.md §16/§17 Track B) ---
// The sidebar API response only carries `state` per unique entry; merge in
// the definition/example/wordId already loaded in `annotations` (same data
// the old inline tooltip read) rather than duplicating it server-side.
const STATE_LABEL: Record<CardState, string> = {
  new: 'New',
  learning: 'Learning',
  relearning: 'Learning',
  review: 'Know',
};
const STATE_CLASS: Record<CardState, string> = {
  new: 'new',
  learning: 'learning',
  relearning: 'learning',
  review: 'know',
};

interface SidebarWordView {
  wordDefinitionId: string;
  wordId: string;
  lemma: string;
  state: CardState;
  definition: string | null;
  example: string | null;
  cefrLevel: CefrLevel | null;
}
interface SidebarPhraseView {
  phraseId: string;
  text: string;
  state: CardState;
  definition: string | null;
  example: string | null;
  cefrLevel: CefrLevel | null;
}
interface SidebarGrammarView {
  slug: string;
  name: string;
  state: CardState;
  cefrLevel: CefrLevel | null;
}

const sidebarWords: SidebarWordView[] = post.sidebar.words.map((entry) => {
  const detail = post.annotations.words[entry.wordDefinitionId];
  return {
    wordDefinitionId: entry.wordDefinitionId,
    wordId: detail?.wordId ?? '',
    lemma: entry.lemma,
    state: entry.state,
    definition: detail?.definition ?? null,
    example: detail?.example ?? null,
    cefrLevel: detail?.cefrLevel ?? null,
  };
});
const sidebarPhrases: SidebarPhraseView[] = post.sidebar.phrases.map(
  (entry) => {
    const detail = post.annotations.phrases[entry.phraseId];
    return {
      phraseId: entry.phraseId,
      text: entry.text,
      state: entry.state,
      definition: detail?.definition ?? null,
      example: detail?.example ?? null,
      cefrLevel: detail?.cefrLevel ?? null,
    };
  },
);
const sidebarGrammar: SidebarGrammarView[] = post.sidebar.grammar.map(
  (entry) => {
    const detail = post.annotations.grammar[entry.slug];
    return {
      slug: entry.slug,
      name: entry.name,
      state: entry.state,
      cefrLevel: detail?.cefrLevel ?? null,
    };
  },
);

// One-line completion summary shown after the quiz (PLAN.md §16) — derived
// straight from the sidebar's own state distribution, not a separate stat.
const newLexiconCount = [...sidebarWords, ...sidebarPhrases].filter(
  (e) => e.state === 'new',
).length;
const learningGrammarCount = sidebarGrammar.filter(
  (e) => e.state === 'learning' || e.state === 'relearning',
).length;
const summaryParts: string[] = [];
if (newLexiconCount > 0) {
  summaryParts.push(
    `+${newLexiconCount} new word${newLexiconCount === 1 ? '' : 's'}`,
  );
}
if (learningGrammarCount > 0) {
  summaryParts.push(
    `${learningGrammarCount} construction${learningGrammarCount === 1 ? '' : 's'} learning`,
  );
}
const summaryLine = summaryParts.join(' · ');

// --- exercise view models (all casts / normalisation live here; the template
// only maps over plain data) ---
type Ex = PostDetail['exercises'][number];

function splitBlank(prompt: string): { before: string; after: string } {
  const i = prompt.indexOf('____');
  return i === -1
    ? { before: prompt, after: '' }
    : { before: prompt.slice(0, i), after: prompt.slice(i + 4) };
}

interface DrillView {
  id: string;
  type: 'fill_blank' | 'multiple_choice' | 'find_error' | 'reorder';
  before: string;
  after: string;
  prompt: string;
  answer: string;
  answerIndex: number;
  options: string[];
  scrambled: string[];
  order: number[];
}

function toDrill(ex: Ex): DrillView | null {
  const p = ex.payload as Record<string, unknown>;
  const base = {
    id: ex.id,
    before: '',
    after: '',
    prompt: '',
    answer: '',
    answerIndex: -1,
    options: [] as string[],
    scrambled: [] as string[],
    order: [] as number[],
  };
  if (ex.type === 'fill_blank') {
    const { before, after } = splitBlank(String(p.prompt ?? ''));
    return { ...base, type: 'fill_blank', before, after, answer: String(p.answer ?? '') };
  }
  if (ex.type === 'multiple_choice') {
    const { before, after } = splitBlank(String(p.prompt ?? ''));
    return {
      ...base,
      type: 'multiple_choice',
      before,
      after,
      options: Array.isArray(p.options) ? (p.options as string[]) : [],
      answerIndex: Number(p.answerIndex ?? -1),
    };
  }
  if (ex.type === 'find_error') {
    return {
      ...base,
      type: 'find_error',
      prompt: String(p.prompt ?? ''),
      answer: String(p.correction ?? ''),
    };
  }
  if (ex.type === 'reorder') {
    return {
      ...base,
      type: 'reorder',
      scrambled: Array.isArray(p.scrambled) ? (p.scrambled as string[]) : [],
      order: Array.isArray(p.answer) ? (p.answer as number[]) : [],
    };
  }
  return null;
}

interface ComprehensionView {
  id: string;
  questions: { question: string; options: string[]; answerIndex: number }[];
}

function toComprehension(ex: Ex): ComprehensionView {
  const p = ex.payload as Record<string, unknown>;
  // The pipeline emits one comprehension question per exercise row, flat on
  // the payload (`{ question, options, answerIndex }`). Older/aggregate shapes
  // may still carry a `questions` array — accept both.
  const raw = p.questions;
  const questions = Array.isArray(raw)
    ? (raw as { question: string; options: string[]; answerIndex: number }[])
    : [
        {
          question: String(p.question ?? ''),
          options: Array.isArray(p.options) ? (p.options as string[]) : [],
          answerIndex: Number(p.answerIndex ?? -1),
        },
      ].filter((q) => q.question !== '' && q.options.length > 0);
  return { id: ex.id, questions };
}

const drills: DrillView[] = post.exercises
  .map(toDrill)
  .filter((d): d is DrillView => d !== null);
const comprehension: ComprehensionView[] = post.exercises
  .filter((e) => e.type === 'comprehension')
  .map(toComprehension);
---

<Layout
  title={`${post.title ?? 'Reading'} — Engofy`}
  user={user}
  active="feed"
>
  <div class="reader-layout" data-slug-id={slugId}>
    <article class="reader-article">
      <header class="post-head">
        <div class="post-head__meta">
          {post.cefrLevel && <span class="badge">{post.cefrLevel}</span>}
          <time datetime={post.publishedAt}>{published}</time>
        </div>
        <h1>{post.title ?? 'Untitled'}</h1>
        {
          (post.sourceType !== 'original' || post.sourceLink) && (
            <p class="post-head__source">
              {post.sourceType !== 'original' && <span>{post.attributionText}</span>}
              {post.sourceLink && (
                <>
                  {post.sourceType !== 'original' ? ' — ' : 'Source: '}
                  <a
                    href={post.sourceLink}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {post.sourceLink}
                  </a>
                </>
              )}
            </p>
          )
        }
      </header>

      <div class="analysis reading-body" set:html={bodyHtml} />
    </article>

    <aside class="sidebar" aria-label="In this article">
      <details class="sidebar__group" open>
        <summary>
          Grammar <span class="sidebar__count">{sidebarGrammar.length}</span>
        </summary>
        <ul class="sidebar__list">
          {
            sidebarGrammar.map((g) => (
              <li class="sidebar__item">
                <div class="sidebar__label">
                  <a href={`/grammar/${g.slug}`}>{g.name}</a>
                  <span class={`badge badge--${STATE_CLASS[g.state]}`}>
                    {STATE_LABEL[g.state]}
                  </span>
                </div>
              </li>
            ))
          }
          {sidebarGrammar.length === 0 && <li class="sidebar__empty">None in this article.</li>}
        </ul>
      </details>

      <details class="sidebar__group" open>
        <summary>
          Words <span class="sidebar__count">{sidebarWords.length}</span>
        </summary>
        <ul class="sidebar__list">
          {
            sidebarWords.map((w) => (
              <li class="sidebar__item">
                <div class="sidebar__label">
                  <b>{w.lemma}</b>
                  <span class={`badge badge--${STATE_CLASS[w.state]}`}>
                    {STATE_LABEL[w.state]}
                  </span>
                </div>
                {w.definition && <p class="sidebar__def">{w.definition}</p>}
                {w.state === 'new' && w.wordId && (
                  <form
                    hx-post="/partials/add-card"
                    hx-swap="outerHTML"
                    hx-target="this"
                    class="add-card__form"
                  >
                    <input type="hidden" name="wordId" value={w.wordId} />
                    <button type="submit" class="add-card">+ Add to deck</button>
                  </form>
                )}
              </li>
            ))
          }
          {sidebarWords.length === 0 && <li class="sidebar__empty">None in this article.</li>}
        </ul>
      </details>

      <details class="sidebar__group" open>
        <summary>
          Phrases <span class="sidebar__count">{sidebarPhrases.length}</span>
        </summary>
        <ul class="sidebar__list">
          {
            sidebarPhrases.map((p) => (
              <li class="sidebar__item">
                <div class="sidebar__label">
                  <b>{p.text}</b>
                  <span class={`badge badge--${STATE_CLASS[p.state]}`}>
                    {STATE_LABEL[p.state]}
                  </span>
                </div>
                {p.definition && <p class="sidebar__def">{p.definition}</p>}
                {p.state === 'new' && (
                  <form
                    hx-post="/partials/add-card"
                    hx-swap="outerHTML"
                    hx-target="this"
                    class="add-card__form"
                  >
                    <input type="hidden" name="phraseId" value={p.phraseId} />
                    <button type="submit" class="add-card">+ Add to deck</button>
                  </form>
                )}
              </li>
            ))
          }
          {sidebarPhrases.length === 0 && <li class="sidebar__empty">None in this article.</li>}
        </ul>
      </details>
    </aside>
  </div>

  {
    drills.length > 0 && (
      <section class="exercises">
        <h2>Practice</h2>
        {drills.map((d) => (
          <div class="exercise" data-ex-type={d.type} data-answer={d.answer} data-answer-index={String(d.answerIndex)} data-order={JSON.stringify(d.order)}>
            {d.type === 'fill_blank' && (
              <p class="exercise__q">
                {d.before}
                <input class="exercise__blank" type="text" aria-label="Missing word" />
                {d.after}
              </p>
            )}
            {d.type === 'multiple_choice' && (
              <>
                <p class="exercise__q">{d.before}<b>____</b>{d.after}</p>
                <ul class="exercise__options">
                  {d.options.map((opt, i) => (
                    <li>
                      <label>
                        <input type="radio" name={`mc-${d.id}`} value={String(i)} />
                        {opt}
                      </label>
                    </li>
                  ))}
                </ul>
              </>
            )}
            {d.type === 'find_error' && (
              <>
                <p class="exercise__hint">One word is in the wrong form. Type the correct form.</p>
                <p class="exercise__q">{d.prompt}</p>
                <input class="exercise__blank" type="text" aria-label="Correct form" />
              </>
            )}
            {d.type === 'reorder' && (
              <>
                <p class="exercise__hint">Put the words in order.</p>
                <div class="exercise__chips">
                  {d.scrambled.map((tok, slot) => (
                    <button type="button" class="exercise__chip" data-slot={String(slot)}>
                      {tok}
                    </button>
                  ))}
                </div>
                <p class="exercise__build" aria-live="polite" />
                <button class="btn btn--ghost exercise__reset" type="button">Reset</button>
              </>
            )}
            {d.type !== 'reorder' && (
              <button class="btn btn--ghost exercise__check" type="button">Check</button>
            )}
            <span class="exercise__result" role="status" />
          </div>
        ))}
      </section>
    )
  }

  {
    comprehension.length > 0 && (
      <section class="exercises">
        <h2>Comprehension</h2>
        {comprehension.map((c) => (
          <div class="exercise" data-ex-type="comprehension">
            {c.questions.map((q, qi) => (
              <fieldset class="exercise__cq" data-answer={String(q.answerIndex)}>
                <legend>{q.question}</legend>
                {q.options.map((opt, oi) => (
                  <label class="exercise__opt">
                    <input type="radio" name={`cq-${c.id}-${qi}`} value={String(oi)} />
                    {opt}
                  </label>
                ))}
              </fieldset>
            ))}
            <button class="btn btn--ghost exercise__check" type="button">Check answers</button>
            <span class="exercise__result" role="status" />
          </div>
        ))}
      </section>
    )
  }

  {
    summaryLine && (
      <p class="reader-summary">{summaryLine}</p>
    )
  }
</Layout>

<script is:inline>
  (() => {
    const norm = (s) => String(s ?? '').trim().toLowerCase();
    function setResult(box, ok) {
      const r = box.querySelector('.exercise__result');
      if (!r) return;
      r.textContent = ok ? '✓ Correct' : '✗ Try again';
      r.className = `exercise__result ${ok ? 'is-ok' : 'is-bad'}`;
    }

    for (const box of document.querySelectorAll('.exercise')) {
      const type = box.getAttribute('data-ex-type');

      if (type === 'reorder') {
        const order = JSON.parse(box.getAttribute('data-order') || '[]');
        const build = box.querySelector('.exercise__build');
        const picks = [];
        box.querySelectorAll('.exercise__chip').forEach((chip) => {
          chip.addEventListener('click', () => {
            if (chip.disabled) return;
            chip.disabled = true;
            picks.push({
              slot: Number(chip.getAttribute('data-slot')),
              tok: chip.textContent.trim(),
            });
            build.textContent = picks.map((p) => p.tok).join(' ');
            const seq = picks.map((p) => order[p.slot]);
            if (seq.length === order.length) {
              setResult(box, seq.every((v, i) => v === i));
            }
          });
        });
        box.querySelector('.exercise__reset')?.addEventListener('click', () => {
          picks.length = 0;
          build.textContent = '';
          box
            .querySelectorAll('.exercise__chip')
            .forEach((c) => (c.disabled = false));
          const r = box.querySelector('.exercise__result');
          if (r) {
            r.textContent = '';
            r.className = 'exercise__result';
          }
        });
        continue;
      }

      const check = box.querySelector('.exercise__check');
      if (!check) continue;
      check.addEventListener('click', () => {
        if (type === 'fill_blank' || type === 'find_error') {
          const input = box.querySelector('.exercise__blank');
          setResult(box, norm(input?.value) === norm(box.getAttribute('data-answer')));
        } else if (type === 'multiple_choice') {
          const sel = box.querySelector('input[type=radio]:checked');
          setResult(
            box,
            sel != null && sel.value === box.getAttribute('data-answer-index'),
          );
        } else if (type === 'comprehension') {
          let ok = true;
          box.querySelectorAll('.exercise__cq').forEach((fs) => {
            const sel = fs.querySelector('input[type=radio]:checked');
            if (!sel || sel.value !== fs.getAttribute('data-answer')) ok = false;
          });
          setResult(box, ok);

          // Marks the post read for feed dedup (PLAN.md §16/§17 Track B) —
          // regardless of correctness, and only once per page view.
          if (!box.dataset.readMarked) {
            box.dataset.readMarked = '1';
            const slugId = document
              .querySelector('.reader-layout')
              ?.getAttribute('data-slug-id');
            if (slugId) {
              fetch('/partials/mark-read', {
                method: 'POST',
                body: new URLSearchParams({ slugId }),
              }).catch(() => {});
            }
          }
        }
      });
    }
  })();
</script>

<style>
  .post-head {
    margin-bottom: 1.5rem;
  }
  .post-head__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--color-ink-soft);
    margin-bottom: 0.4rem;
  }
  .post-head__source {
    font-size: 0.8rem;
    color: var(--color-ink-soft);
    word-break: break-all;
  }
  .reading-body {
    font-size: 1.075rem;
  }
  .reader-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 960px) {
    .reader-layout {
      grid-template-columns: minmax(0, 42rem) minmax(220px, 280px);
      align-items: start;
      justify-content: center;
    }
  }
  .reader-article {
    min-width: 0;
  }
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 960px) {
    .sidebar {
      position: sticky;
      top: 1rem;
    }
  }
  .sidebar__group {
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    padding: 0.7rem 0.9rem;
  }
  .sidebar__group summary {
    font-weight: 600;
    cursor: pointer;
  }
  .sidebar__count {
    color: var(--color-ink-soft);
    font-weight: 400;
    font-size: 0.85rem;
  }
  .sidebar__list {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
  }
  .sidebar__item {
    margin: 0 0 0.75rem;
  }
  .sidebar__item:last-child {
    margin-bottom: 0;
  }
  .sidebar__label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .sidebar__def {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .sidebar__empty {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .badge--new {
    background: var(--color-paper-soft);
    color: var(--color-ink-soft);
  }
  .badge--learning {
    background: var(--color-brand-wash);
    color: var(--color-brand-strong);
  }
  .badge--know {
    background: var(--color-brand-wash);
    color: var(--color-success);
  }
  .reader-summary {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-brand-strong);
  }
  .exercises {
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }
  .exercise {
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    padding: 1rem;
    margin-bottom: 1rem;
  }
  .exercise__hint,
  .exercise__q {
    margin: 0 0 0.6rem;
  }
  .exercise__hint {
    font-size: 0.8rem;
    color: var(--color-ink-soft);
  }
  .exercise__blank {
    font: inherit;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.3rem;
    min-width: 6rem;
  }
  .exercise__options,
  .exercise__opt {
    list-style: none;
    padding: 0;
    margin: 0 0 0.6rem;
  }
  .exercise__opt {
    display: block;
  }
  .exercise__cq {
    border: 0;
    padding: 0;
    margin: 0 0 1rem;
  }
  .exercise__cq legend {
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .exercise__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
  }
  .exercise__chip {
    font: inherit;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.3rem;
    background: var(--color-paper-soft);
    cursor: pointer;
  }
  .exercise__chip:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .exercise__build {
    min-height: 1.4rem;
    font-weight: 600;
    margin: 0 0 0.6rem;
  }
  .exercise__result {
    margin-left: 0.6rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .exercise__result.is-ok {
    color: var(--color-success);
  }
  .exercise__result.is-bad {
    color: var(--color-danger);
  }
</style>
