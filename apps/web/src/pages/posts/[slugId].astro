---
import Layout from '../../layouts/Layout.astro';
import QuickCheck from '../../components/QuickCheck.astro';
import QuickCheckScreen from '../../components/QuickCheckScreen.astro';
import { apiGetOrNull } from '../../lib/api';
import { buildLexiconData } from '../../lib/lexicon-data';
import { postDescription, postJsonLd } from '../../lib/post-seo';
import { escapeJson } from '../../lib/seo';
import {
  buildQuickCheckSteps,
  buildStudySteps,
} from '../../lib/quick-check-steps';
import { postSlugId } from '../../lib/post-url';
import { CEFR_LEVELS } from '../../lib/posts-list';
import { renderDoc } from '../../lib/render-doc';
import { getCurrentUser } from '../../lib/session';
import { publicOrigin } from '../../lib/site';
import type {
  CefrLevel,
  NewCardBudgetResponse,
  PostDetail,
  PracticeQueueResponse,
  ProfileHub,
  StreakResponse,
} from '../../lib/types';

const { slugId } = Astro.params;
const user = await getCurrentUser(Astro.request);
const post = slugId
  ? await apiGetOrNull<PostDetail>(
      `/content/posts/${encodeURIComponent(slugId)}`,
      { request: Astro.request },
    )
  : null;

if (!post) {
  return new Response('Not found', { status: 404 });
}

// The API resolves a post by its shortId alone, so any slug prefix answers
// 200. Send every other spelling to the one canonical URL, query kept.
const canonicalSlugId = postSlugId(post);
if (slugId !== canonicalSlugId) {
  return Astro.redirect(
    `/posts/${canonicalSlugId}${Astro.url.search}`,
    301,
  );
}

const published = new Date(post.publishedAt).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const title = post.title ?? 'Untitled';
const description = postDescription(
  post.doc,
  'A short English text to read, with word and grammar help.',
);
const jsonLd = escapeJson(
  postJsonLd(post, publicOrigin(Astro.url), description),
);

const lexicon = buildLexiconData(post.annotations, post.exercises);
const lexiconJson = escapeJson(lexicon);
// `?? []`: an API still on the previous release omits `tokens`.
const hasTokens = (post.annotations.tokens ?? []).length > 0;

// --- final screen ---
const newWordCount = Object.values(lexicon.words).filter(
  (w) => w.state === 'new',
).length;
const grammarCount = Object.keys(lexicon.grammar).length;
const summaryParts = [
  newWordCount > 0 && `${newWordCount} new word${newWordCount === 1 ? '' : 's'}`,
  grammarCount > 0 &&
    `${grammarCount} grammar pattern${grammarCount === 1 ? '' : 's'}`,
].filter(Boolean);
const summaryText =
  summaryParts.length > 0
    ? `This text had ${summaryParts.join(' and ')} to learn.`
    : 'This text had nothing new for your level.';

// Both are best-effort, signed-in only: an API on the previous release lacks
// the budget route, and neither may take the page down.
const [budget, dueCards, streakResponse, profile] = user
  ? await Promise.all([
      apiGetOrNull<NewCardBudgetResponse>('/learning/new-card-budget', {
        request: Astro.request,
      }).catch(() => null),
      apiGetOrNull<PracticeQueueResponse>(
        `/learning/posts/${encodeURIComponent(slugId ?? '')}/due-cards`,
        { request: Astro.request },
      ).catch(() => null),
      apiGetOrNull<StreakResponse>('/learning/streak', {
        request: Astro.request,
      }).catch(() => null),
      apiGetOrNull<ProfileHub>('/profile', {
        request: Astro.request,
      }).catch(() => null),
    ])
  : [null, null, null, null];

// Labels at or below the reader's level stay unhighlighted by default. A guest
// has no level: one step under the text's own keeps the hard words lit.
const guestLevel: CefrLevel | null = post.cefrLevel
  ? CEFR_LEVELS[Math.max(CEFR_LEVELS.indexOf(post.cefrLevel) - 1, 0)]
  : null;
const readerLevel = profile?.cefrLevel ?? guestLevel;
const bodyHtml = renderDoc(post.doc, post.annotations, readerLevel);

const dueCount = dueCards?.items.length ?? 0;
const steps = buildQuickCheckSteps(
  post.exercises,
  lexicon,
  dueCards?.items ?? [],
);
const studySteps = buildStudySteps(
  post.doc,
  post.exercises,
  lexicon,
  dueCards?.items ?? [],
);
const streak = streakResponse?.streak ?? 0;
// The Home session sends the learner here with ?from=home and its next step
// (today's practice) lives on Home.
const fromHome = Astro.url.searchParams.get('from') === 'home';
const isRead = post.isRead ?? false;
---

<Layout
  title={`${title} — Engofy`}
  description={description}
  ogType="article"
  user={user}
  active="posts"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.publishedAt} />
    {post.cefrLevel && <meta property="article:tag" content={post.cefrLevel} />}
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <div class="reader-layout" data-slug-id={slugId} data-new-budget={budget?.remaining}>
    <article class="reader-article">
      <header class="post-head">
        <a class="post-head__back meta" href="/posts">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
          Posts
        </a>
        <div class="post-head__meta">
          {post.cefrLevel && <span class="badge">{post.cefrLevel}</span>}
          <time datetime={post.publishedAt}>{published}</time>
          {
            user && (
              <span class="post-head__read" data-read-state data-read={String(isRead)}>
                <span class="tag tone-green" data-read-badge hidden={!isRead}>✓ Read</span>
                <button type="button" class="btn btn--ghost btn--sm" data-read-toggle>
                  {isRead ? 'Mark as unread' : 'Mark as read'}
                </button>
              </span>
            )
          }
        </div>
        <h1>{title}</h1>
        {
          (post.sourceType !== 'original' || post.sourceLink) && (
            <p class="post-head__source">
              {post.sourceType !== 'original' && <span>{post.attributionText}</span>}
              {post.sourceLink && (
                <>
                  {post.sourceType !== 'original' ? ' — ' : 'Source: '}
                  <a
                    href={post.sourceLink}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {post.sourceLink}
                  </a>
                </>
              )}
            </p>
          )
        }
      </header>

      <div class="reader-toolbar" role="toolbar" aria-label="Reader tools">
        {
          hasTokens && (
            <>
              <button type="button" class="reader-toolbar__btn tone-green" data-mode="pos" aria-pressed="false" title="Underline nouns, verbs, adjectives and adverbs in different colours">
                <b aria-hidden="true">Aa</b>Word types
              </button>
              <button type="button" class="reader-toolbar__btn tone-blue" data-mode="tense" aria-pressed="false" title="Mark past, present and future verbs with a coloured line above">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 8v4l2.5 2.5" /></svg>Tenses
              </button>
              <button type="button" class="reader-toolbar__btn tone-pink" data-mode="analyze" aria-pressed="false" title="Label every word with its type and explain each grammar pattern">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="M20 20l-5.5-5.5" /></svg>Analyze
              </button>
            </>
          )
        }
        <button type="button" class="reader-toolbar__btn tone-amber" data-study-toggle aria-pressed="false" title="Read one paragraph at a time with a short quiz after each">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4l13 8-13 8V4z" /></svg>Study mode
        </button>
        <span class="reader-toolbar__size">
          <button type="button" class="reader-toolbar__btn reader-toolbar__step" data-size="-1" aria-label="Smaller text">A−</button>
          <button type="button" class="reader-toolbar__btn reader-toolbar__step" data-size="1" aria-label="Larger text">A+</button>
        </span>
        <div class="reader-legend" data-legend="pos">
          <span class="reader-legend__item tone-blue" data-pos-group="noun">noun</span>
          <span class="reader-legend__item tone-brand" data-pos-group="verb">verb</span>
          <span class="reader-legend__item tone-green" data-pos-group="adj">adjective</span>
          <span class="reader-legend__item tone-pink" data-pos-group="adv">adverb</span>
        </div>
        <p class="reader-legend" data-legend="tense">
          <span class="reader-legend__item tone-pink" data-tense="past">past</span>
          <span class="reader-legend__item tone-green" data-tense="present">present</span>
          <span class="reader-legend__item tone-brand" data-tense="future">future</span>
        </p>
        <p class="reader-legend" data-legend="analyze">
          Tap a highlighted construction to see why it fits. Irregular verbs show their forms.
        </p>
      </div>

      <p class="reader-hint">
        <span>Tap a highlighted word or phrase to see what it means.</span>
        <button type="button" class="reader-hint__close" data-reader-hint-close aria-label="Dismiss hint">Got it</button>
      </p>
      <div class="reader-key" aria-label="Highlights">
        <span class="reader-key__item"><i class="reader-key__chip reader-key__chip--word"></i>Word or phrase</span>
        <span class="reader-key__item"><i class="reader-key__chip reader-key__chip--gram"></i>Grammar</span>
        <span class="reader-key__density" role="group" aria-label="Highlight density">
          <span class="reader-key__label">Show</span>
          <button type="button" class="reader-key__opt" data-density="focus" aria-pressed="false" title="Only words and patterns above your level">New for me</button>
          <button type="button" class="reader-key__opt" data-density="all" aria-pressed="false" title="Every word and pattern you have not learned yet">All</button>
          <button type="button" class="reader-key__opt" data-density="off" aria-pressed="false" title="Plain text; tap any word to look it up">None</button>
        </span>
      </div>

      <div class="analysis reading-body" set:html={bodyHtml} />
      <script is:inline type="application/json" id="lexicon-data" set:html={lexiconJson} />
      {
        [...studySteps].map(([block, steps]) => (
          <template data-study-steps={String(block)}>
            <div class="qc qc--inline" data-qc>
              {steps.map((step, si) => (
                <QuickCheckScreen step={step} si={si} total={steps.length} lastLabel="Done" />
              ))}
            </div>
          </template>
        ))
      }
    </article>
  </div>

  <section class="reader-final" data-reader-final aria-label="Quick check">
    <QuickCheck
      steps={steps}
      postTitle={post.title}
      summaryText={summaryText}
      signedIn={Boolean(user)}
      streak={streak}
      dueCount={dueCount}
      fromHome={fromHome}
    />
  </section>

</Layout>

<script>
  import type { LexiconData } from '../../lib/reader-lexicon';
  import { initReaderFinal } from '../../lib/reader-final';
  import { initReadState } from '../../lib/reader-read';
  import { initReaderHelp } from '../../lib/reader-help';
  import { initReaderPopup } from '../../lib/reader-popup';
  import { initReaderStudy } from '../../lib/reader-study';
  import { initReaderToolbar } from '../../lib/reader-toolbar';

  const body = document.querySelector<HTMLElement>('.reading-body');
  const raw = document.getElementById('lexicon-data')?.textContent;
  const lexicon: LexiconData | null = raw ? JSON.parse(raw) : null;
  if (body && lexicon) {
    initReaderPopup(body, lexicon);
  }
  const toolbar = document.querySelector<HTMLElement>('.reader-toolbar');
  if (toolbar) {
    initReaderToolbar(toolbar);
  }

  const article = document.querySelector<HTMLElement>('.reader-article');
  if (article) {
    initReaderHelp(article);
  }

  const layout = document.querySelector<HTMLElement>('.reader-layout');
  const final = document.querySelector<HTMLElement>('[data-reader-final]');
  const readState = document.querySelector<HTMLElement>('[data-read-state]');
  const readControl =
    layout && final && readState
      ? initReadState(
          readState,
          final,
          layout.dataset.slugId ?? '',
          readState.dataset.read === 'true',
        )
      : null;
  if (final) {
    initReaderFinal(final, readControl ? () => readControl.mark() : null);
  }
  const studyToggle = toolbar?.querySelector<HTMLElement>('[data-study-toggle]');
  if (body && lexicon && studyToggle && final) {
    const budget = layout?.dataset.newBudget;
    initReaderStudy({
      root: body,
      toggle: studyToggle,
      lexicon,
      budget: budget === undefined ? null : Number(budget),
      onFinish: (detail) =>
        final.dispatchEvent(new CustomEvent('reader:finish', { detail })),
    });
  }
</script>

<style>
  .post-head {
    margin-bottom: 1.5rem;
  }
  .post-head__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1rem;
    text-decoration: none;
  }
  .post-head__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink-faint);
    margin-bottom: 0.75rem;
  }
  .post-head__read {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
  }
  .post-head__source {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink-faint);
    word-break: break-all;
  }
  .post-head h1 {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .reading-body {
    font-size: var(--reader-font-size);
    line-height: 1.85;
  }
  /* The chip colours and the `data-known` / `data-quiet` / density rules live
     in app.css. The spans come from set:html, so the selectors must be :global. */
  .reading-body :global([data-word-definition-id]),
  .reading-body :global([data-phrase-id]),
  .reading-body :global([data-grammar-usage-point-id]) {
    cursor: pointer;
    border-radius: 0.5rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .reading-body :global(.is-active) {
    outline: 2px solid var(--color-brand);
    outline-offset: 1px;
  }
  .reader-article {
    min-width: 0;
  }
</style>
