---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import GrammarSection from '../../components/grammar/GrammarSection.astro';
import GrammarShell from '../../components/grammar/GrammarShell.astro';
import { apiGetOrNull } from '../../lib/api';
import { renderCheatSheetBullets } from '../../lib/markdown';
import { getCurrentUser } from '../../lib/session';
import type { GrammarConstructionDetail } from '../../lib/types';

// Handcrafted construction pages live in `src/grammar-pages/<slug>.astro` and
// each render their own body inside `GrammarShell`. A slug without one falls
// back to the generic render (the imported cheat sheet) in the same shell.
const handcraftedPages = import.meta.glob<{ default: AstroComponentFactory }>(
  '../../grammar-pages/*.astro',
  { eager: true },
);

const { slug } = Astro.params;
const user = await getCurrentUser(Astro.request);
const con = slug
  ? await apiGetOrNull<GrammarConstructionDetail>(
      `/content/grammar/${encodeURIComponent(slug)}`,
      { request: Astro.request },
    )
  : null;

if (!con) {
  return new Response('Not found', { status: 404 });
}

const Page = handcraftedPages[`../../grammar-pages/${con.slug}.astro`]?.default;
const cheatSheet =
  !Page && con.cheatSheetContent
    ? renderCheatSheetBullets(con.cheatSheetContent)
    : null;
// Short cheat sheets (few EGP form facts) read fine open; long ones collapse
// behind their own nested toggle so "Form" isn't a wall of bullets.
const cheatSheetBulletsOpen = cheatSheet !== null && cheatSheet.count <= 3;
---

{
  Page ? (
    <Page con={con} user={user} />
  ) : (
    <GrammarShell
      con={con}
      user={user}
      sections={cheatSheet ? [{ id: 'form', title: 'Form', open: true }] : []}
    >
      {
        cheatSheet && (
          <GrammarSection title="Form" id="form" open>
            <details class="gp-form-bullets" open={cheatSheetBulletsOpen}>
              <summary>
                {cheatSheetBulletsOpen
                  ? 'Form details'
                  : `Show all form details (${cheatSheet.count})`}
              </summary>
              <div class="analysis" set:html={cheatSheet.html} />
            </details>
          </GrammarSection>
        )
      }
    </GrammarShell>
  )
}

<style>
  .gp-form-bullets summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--color-brand-strong);
  }
  .gp-form-bullets summary::-webkit-details-marker {
    display: none;
  }
  .gp-form-bullets[open] summary {
    margin-bottom: 0.5rem;
  }
</style>
