---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import GrammarShell from '../../components/grammar/GrammarShell.astro';
import { apiGetOrNull } from '../../lib/api';
import { renderMarkdown } from '../../lib/markdown';
import { getCurrentUser } from '../../lib/session';
import type { GrammarConstructionDetail } from '../../lib/types';

// Handcrafted construction pages live in `src/grammar-pages/<slug>.astro` and
// each render their own body inside `GrammarShell`. A slug without one falls
// back to the generic render (the imported cheat sheet) in the same shell.
const handcraftedPages = import.meta.glob<{ default: AstroComponentFactory }>(
  '../../grammar-pages/*.astro',
  { eager: true },
);

const { slug } = Astro.params;
const user = await getCurrentUser(Astro.request);
const con = slug
  ? await apiGetOrNull<GrammarConstructionDetail>(
      `/content/grammar/${encodeURIComponent(slug)}`,
      { request: Astro.request },
    )
  : null;

if (!con) {
  return new Response('Not found', { status: 404 });
}

const Page = handcraftedPages[`../../grammar-pages/${con.slug}.astro`]?.default;
const cheatSheetHtml =
  !Page && con.cheatSheetContent ? renderMarkdown(con.cheatSheetContent) : null;
---

{
  Page ? (
    <Page con={con} user={user} />
  ) : (
    <GrammarShell con={con} user={user}>
      {
        cheatSheetHtml && (
          <section class="cheat">
            <div class="analysis" set:html={cheatSheetHtml} />
          </section>
        )
      }
    </GrammarShell>
  )
}

<style>
  .cheat {
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    background: var(--color-paper-soft);
  }
</style>
