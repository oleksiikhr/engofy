---
import Layout from '../layouts/Layout.astro';
import { apiGet, apiPatch, apiPost } from '../lib/api';
import { grammarSlugs } from '../lib/grammar-seo';
import { renderDailyPracticeQueue } from '../lib/practice-card';
import { postUrl } from '../lib/post-url';
import { jsonLdGraph } from '../lib/seo';
import { getCurrentUser } from '../lib/session';
import { publicOrigin } from '../lib/site';
import type {
  CefrLevel,
  CompleteDailyPlanResponse,
  DailyPlan,
  GrammarReference,
  PostsListResponse,
  PracticeQueueResponse,
} from '../lib/types';

const LEVELS: CefrLevel[] = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];

const FEATURES = [
  {
    title: 'Read real texts at your level',
    text: 'Short authentic articles, sorted from A1 to C2, so every text is just hard enough.',
  },
  {
    title: 'Tap any word',
    text: 'See what a word means in this sentence, without leaving the page.',
  },
  {
    title: 'Learn grammar in context',
    text: 'Every text links to the constructions it uses, from the English Grammar Profile.',
  },
  {
    title: 'Remember what you read',
    text: 'A short daily session brings back your saved words with spaced repetition and keeps your streak going.',
  },
];

const HOME_TITLE = 'Engofy — Learn English by Reading Short Texts (A1–C2)';
const HOME_DESCRIPTION =
  'Read short authentic English texts sorted by level (A1–C2). Tap any word for its meaning, learn grammar in context and remember words with daily spaced repetition.';

const LATEST_POSTS = 6;
const FEATURED_GRAMMAR = 4;

// Constructions with a handcrafted page come first, so the links lead to the
// best pages; the rest of the reference fills any remaining slots.
const handcrafted = new Set(
  Object.keys(
    import.meta.glob('../grammar-pages/*.astro'),
  ).map((path) => path.replace('../grammar-pages/', '').replace('.astro', '')),
);

const SHOTS = [
  {
    src: '/landing/reader.png',
    alt: 'The reader with a word definition open next to the text',
    caption: 'Read and tap any word',
  },
  {
    src: '/landing/grammar.png',
    alt: 'A grammar construction page with level and examples',
    caption: 'Grammar linked to what you read',
  },
  {
    src: '/landing/dictionary.png',
    alt: 'A personal dictionary listing saved words and phrases with their status',
    caption: 'Every word you save, in one place',
  },
];

const user = await getCurrentUser(Astro.request);

// --- Onboarding (learning-foundation's one-shot post-signup signal) ---
// Blocks the daily session behind a single CEFR-level prompt while the
// short-lived `onboarding` cookie is present, then clears it. Handled before
// the daily plan is ever fetched: the plan picks a post by CEFR±1 the first
// time it's requested each day, so the learner's real level should be set
// before that pick happens, not after.
if (user && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');
  if (action === 'save' || action === 'skip') {
    const level = form.get('cefrLevel');
    if (
      action === 'save' &&
      typeof level === 'string' &&
      (LEVELS as string[]).includes(level)
    ) {
      await apiPatch(
        '/profile/cefr-level',
        { cefrLevel: level },
        { request: Astro.request },
      ).catch(() => {});
    }
    Astro.cookies.delete('onboarding', { path: '/' });
    return Astro.redirect('/');
  }
}

// Guest landing only: fresh internal links for crawlers and visitors. Each
// block is optional, so an API failure never takes the landing page down.
let latestPosts: PostsListResponse['items'] = [];
let featuredGrammar: { slug: string; name: string }[] = [];
if (!user) {
  const [postsResult, grammarResult] = await Promise.allSettled([
    apiGet<PostsListResponse>(`/content/posts?limit=${LATEST_POSTS}`),
    apiGet<GrammarReference>('/content/grammar'),
  ]);
  if (postsResult.status === 'fulfilled') {
    latestPosts = postsResult.value.items;
  }
  if (grammarResult.status === 'fulfilled') {
    const constructions = grammarResult.value.groups.flatMap(
      (group) => group.constructions,
    );
    const known = new Set(grammarSlugs(grammarResult.value));
    const ordered = [
      ...[...handcrafted].filter((slug) => known.has(slug)),
      ...[...known].filter((slug) => !handcrafted.has(slug)),
    ].slice(0, FEATURED_GRAMMAR);
    featuredGrammar = ordered.flatMap((slug) => {
      const con = constructions.find((c) => c.slug === slug);
      return con ? [{ slug, name: con.name }] : [];
    });
  }
}

const origin = publicOrigin(Astro.url);
const jsonLd = jsonLdGraph([
  {
    '@type': 'WebSite',
    '@id': `${origin}/#website`,
    url: `${origin}/`,
    name: 'Engofy',
    inLanguage: 'en',
    publisher: { '@id': `${origin}/#organization` },
  },
  {
    '@type': 'Organization',
    '@id': `${origin}/#organization`,
    name: 'Engofy',
    url: `${origin}/`,
  },
]);

const showOnboarding =
  !!user && Astro.cookies.get('onboarding')?.value === '1';

let plan: DailyPlan | null = null;
let summary: CompleteDailyPlanResponse | null = null;
let cards: PracticeQueueResponse | null = null;

if (user && !showOnboarding) {
  plan = await apiGet<DailyPlan>('/home/daily-plan', {
    request: Astro.request,
  });

  if (plan.completedAt) {
    // Idempotent — re-submitting on every revisit just recomputes today's
    // live counts and keeps the original completedAt.
    summary = await apiPost<CompleteDailyPlanResponse>(
      '/home/daily-plan/complete',
      undefined,
      { request: Astro.request },
    );
  } else if (plan.isRead) {
    cards = await apiGet<PracticeQueueResponse>('/home/daily-plan/cards', {
      request: Astro.request,
    });
  }
}

const showPractice = !!plan && !summary && plan.isRead && !!cards && cards.items.length > 0;
const showGrammar = !!plan && !summary && plan.isRead && !!cards && cards.items.length === 0;
const initialPracticeHtml = cards ? renderDailyPracticeQueue(cards.items) : '';
---

<Layout
  title={user ? 'Engofy' : HOME_TITLE}
  description={user ? undefined : HOME_DESCRIPTION}
  user={user}
>
  {
    !user && (
      <Fragment slot="head">
        <script is:inline type="application/ld+json" set:html={jsonLd} />
      </Fragment>
    )
  }
  {
    !user && (
      <div class="landing">
        <section class="landing-hero">
          <p class="eyebrow">Engofy</p>
          <h1>Learn English by reading short texts</h1>
          <p class="landing-hero__lead">
            Learn English through short authentic texts.
          </p>
          <a class="btn btn--lg" href="/login">Get started</a>
        </section>

        <section class="landing-section" aria-label="Features">
          <ul class="features">
            {
              FEATURES.map((f) => (
                <li class="card feature">
                  <h2>{f.title}</h2>
                  <p>{f.text}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="landing-section" aria-label="Product screenshots">
          <div class="shots">
            {
              SHOTS.map((s) => (
                <figure class="shot">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="900"
                    height="540"
                    loading="lazy"
                  />
                  <figcaption>{s.caption}</figcaption>
                </figure>
              ))
            }
          </div>
        </section>

        {latestPosts.length > 0 && (
          <section class="landing-section" aria-label="Latest posts">
            <h2 class="landing-heading">Latest texts</h2>
            <ul class="latest">
              {latestPosts.map((post) => (
                <li class="card latest__item">
                  {post.cefrLevel && <span class="badge">{post.cefrLevel}</span>}
                  <h3>
                    <a href={postUrl(post)}>{post.title ?? 'Untitled'}</a>
                  </h3>
                  <p>{post.excerpt}</p>
                </li>
              ))}
            </ul>
            <p class="landing-more">
              <a href="/posts">See all posts →</a>
            </p>
          </section>
        )}

        <section class="landing-section" aria-label="Grammar">
          <h2 class="landing-heading">Grammar, level by level</h2>
          <p class="landing-more">
            Every construction from the Cambridge English Grammar Profile,
            with examples.
          </p>
          {featuredGrammar.length > 0 && (
            <ul class="grammar-links">
              {featuredGrammar.map((con) => (
                <li>
                  <a href={`/grammar/${encodeURIComponent(con.slug)}`}>
                    {con.name}
                  </a>
                </li>
              ))}
            </ul>
          )}
          <p class="landing-more">
            <a href="/grammar">Browse the grammar reference →</a>
          </p>
        </section>

        <section class="card card--soft landing-cta">
          <h2>Ready to read?</h2>
          <p>Free to start, no password needed.</p>
          <a class="btn" href="/login">Log in</a>
        </section>
      </div>
    )
  }

  {
    user && showOnboarding && (
      <section class="card onboarding">
        <h1>Set your English level</h1>
        <p class="onboarding__lead">
          This picks articles and grammar at the right difficulty for you.
          You can change it later in your profile.
        </p>
        <form method="post">
          <div class="onboarding__levels">
            {LEVELS.map((lvl) => (
              <label class="pill">
                <input
                  type="radio"
                  name="cefrLevel"
                  value={lvl}
                  checked={lvl === 'A1'}
                />
                <span>{lvl}</span>
              </label>
            ))}
          </div>
          <div class="onboarding__actions">
            <button class="btn" type="submit" name="action" value="save">
              Save and continue
            </button>
            <button
              class="btn btn--ghost"
              type="submit"
              name="action"
              value="skip"
              formnovalidate
            >
              Skip
            </button>
          </div>
        </form>
      </section>
    )
  }

  {
    user && !showOnboarding && plan && summary && (
      <section class="card session session-done" data-testid="session-done">
        <p class="session-done__mark tone-green" aria-hidden="true">✓</p>
        <h1>All done for today</h1>
        <p class="session-done__summary">
          {[
            summary.newCardsToday > 0 &&
              `+${summary.newCardsToday} new word${summary.newCardsToday === 1 ? '' : 's'}`,
            summary.reviewsToday > 0 &&
              `${summary.reviewsToday} review${summary.reviewsToday === 1 ? '' : 's'}`,
          ]
            .filter(Boolean)
            .join(' · ') || 'Session complete.'}
        </p>
        <p>
          <a class="btn btn--sec" href="/posts">Read more articles</a>
        </p>
      </section>
    )
  }

  {
    user && !showOnboarding && plan && !summary && !plan.isRead && (
      <section class="card session" data-testid="session-step-read">
        <div class="session__head">
          <p class="eyebrow">Today's session · Step 1 of 3</p>
          <span class="bar"><i style="width: 33%"></i></span>
        </div>
        {plan.postCefrLevel && <span class="badge">{plan.postCefrLevel}</span>}
        <h1>{plan.postTitle ?? 'Today’s reading'}</h1>
        <p>
          <a
            class="btn btn--lg"
            href={`${postUrl({ slug: plan.postSlug, shortId: plan.postShortId })}?from=home`}
          >
            Start reading
          </a>
        </p>
      </section>
    )
  }

  {
    showPractice && (
      <section class="session" data-testid="session-step-practice">
        <div class="session__head">
          <p class="eyebrow">Today's session · Step 2 of 3</p>
          <span class="bar"><i style="width: 66%"></i></span>
        </div>
        <div id="daily-practice-container" set:html={initialPracticeHtml} />
      </section>
    )
  }

  {
    showGrammar && plan && (
      <section class="card session" data-testid="session-step-grammar">
        <div class="session__head">
          <p class="eyebrow">Today's session · Step 3 of 3</p>
          <span class="bar"><i style="width: 100%"></i></span>
        </div>
        {
          plan.grammarGuideword ? (
            <>
              <p class="session-grammar__kicker">{plan.grammarGuideword}</p>
              <p>{plan.grammarCanDoStatement}</p>
              {plan.grammarExampleText && (
                <p class="session-grammar__example">
                  “{plan.grammarExampleText}”
                </p>
              )}
              {plan.grammarConstructionSlug && (
                <p>
                  <a href={`/grammar/${plan.grammarConstructionSlug}`}>
                    Learn more →
                  </a>
                </p>
              )}
            </>
          ) : (
            <p>No new grammar highlight today.</p>
          )
        }
        <form method="post" action="/partials/complete-daily-plan">
          <button class="btn btn--lg" type="submit">Finish for today</button>
        </form>
      </section>
    )
  }
</Layout>

<script>
  import '../lib/practice-client';
</script>

<style>
  .landing-hero {
    text-align: center;
    padding: 3.5rem 1rem 3rem;
  }
  .landing-hero h1 {
    margin: 0.5rem 0;
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 800;
    line-height: 1.05;
  }
  .landing-hero__lead {
    max-width: 30rem;
    margin: 0 auto 2rem;
    font-size: 1.15rem;
    color: var(--color-ink-soft);
  }
  .landing-section {
    padding: 1.5rem 0;
  }
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .feature h2 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    font-weight: 800;
  }
  .feature p {
    margin: 0;
    color: var(--color-ink-soft);
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem;
  }
  .shot {
    margin: 0;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: 1.125rem;
    box-shadow: var(--shadow-sm);
  }
  .shot figcaption {
    margin-top: 0.75rem;
    text-align: center;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .landing-heading {
    margin: 0 0 1rem;
    text-align: center;
    font-size: 1.35rem;
    font-weight: 800;
  }
  .latest {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
  }
  .latest__item h3 {
    margin: 0.5rem 0;
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.3;
  }
  .latest__item h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .latest__item h3 a:hover {
    color: var(--color-brand-strong);
  }
  .latest__item p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .landing-more {
    margin: 1rem 0 0;
    text-align: center;
    color: var(--color-ink-soft);
  }
  .grammar-links {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    font-weight: 700;
  }
  .landing-cta {
    margin-top: 1.5rem;
    padding: 2.25rem 1.5rem;
    text-align: center;
  }
  .landing-cta h2 {
    margin: 0 0 0.25rem;
    font-weight: 800;
  }
  .landing-cta p {
    margin: 0 0 1.25rem;
    color: var(--color-ink-soft);
  }

  .session,
  .onboarding {
    max-width: 34rem;
    margin: 1rem auto 0;
    text-align: center;
  }
  .session__head {
    margin-bottom: 1.25rem;
  }
  .session__head .eyebrow {
    margin: 0 0 0.6rem;
  }
  .session h1,
  .onboarding h1 {
    margin: 0.5rem 0 1rem;
    font-size: 1.6rem;
    font-weight: 800;
  }
  .session-grammar__kicker {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-strong);
  }
  .session-grammar__example {
    font-style: italic;
    color: var(--color-ink-soft);
  }
  .session-done__mark {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto;
    border-radius: 50%;
    background: var(--tone-wash);
    color: var(--tone-ink);
    font-size: 1.75rem;
    font-weight: 800;
  }
  .session-done__summary {
    font-weight: 800;
    color: var(--color-brand-strong);
  }
  .onboarding__lead {
    margin: 0;
    color: var(--color-ink-soft);
  }
  .onboarding__levels {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 1.5rem 0;
  }
  .onboarding__actions {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
  }
</style>
