---
import Layout from '../layouts/Layout.astro';
import { apiGet, apiGetOrNull } from '../lib/api';
import { postUrl } from '../lib/post-url';
import { getCurrentUser } from '../lib/session';
import type { DueCardCountResponse, FeedResponse } from '../lib/types';

const PAGE_SIZE = 12;

const user = await getCurrentUser(Astro.request);

const offsetParam = Number(Astro.url.searchParams.get('offset') ?? '0');
const offset = Number.isFinite(offsetParam) && offsetParam > 0 ? offsetParam : 0;

const feed = await apiGet<FeedResponse>(
  `/content/feed?limit=${PAGE_SIZE}&offset=${offset}`,
  { request: Astro.request },
);

// Soft "N due" badge (PLAN.md §16/§17 Track B) — replaces the old forced
// review-break card inserted every 2-3 posts (PLAN.md §4): a due date is
// already FSRS's own pacing signal, so a mandatory feed insertion fights it
// and works against the "between other things" positioning. Signed-in only —
// a guest has no queue.
const dueCount = user
  ? ((
      await apiGetOrNull<DueCardCountResponse>('/learning/due-count', {
        request: Astro.request,
      })
    )?.dueCount ?? 0)
  : 0;

function fmtDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}
---

<Layout title="Engofy — Feed" user={user} active="feed">
  <h1>Latest reading</h1>

  {feed.items.length === 0 && <p>No posts published yet.</p>}

  {
    user && dueCount > 0 && (
      <p class="feed__note" data-testid="due-badge">
        {dueCount} card{dueCount === 1 ? '' : 's'} due —{' '}
        <a href="/practice">start a review session</a>.
      </p>
    )
  }

  <ul class="feed">
    {
      feed.items.map((post) => (
        <li class="card">
          <div class="feed__meta">
            {post.cefrLevel && <span class="badge">{post.cefrLevel}</span>}
            <time datetime={post.publishedAt}>
              {fmtDate(post.publishedAt)}
            </time>
          </div>
          <h2>
            <a href={postUrl(post)}>{post.title ?? 'Untitled'}</a>
          </h2>
          <p class="feed__excerpt">{post.excerpt}</p>
        </li>
      ))
    }
  </ul>

  <nav class="feed__pager">
    {
      offset > 0 && (
        <a
          class="btn btn--ghost"
          href={offset - PAGE_SIZE > 0 ? `/?offset=${offset - PAGE_SIZE}` : '/'}
        >
          ← Newer
        </a>
      )
    }
    {
      feed.nextOffset !== null && (
        <a class="btn btn--ghost" href={`/?offset=${feed.nextOffset}`}>
          Older →
        </a>
      )
    }
  </nav>
</Layout>

<style>
  .feed {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .feed__note {
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }
  .feed__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--color-ink-soft);
    margin-bottom: 0.35rem;
  }
  .feed h2 {
    margin: 0 0 0.4rem;
  }
  .feed h2 a {
    text-decoration: none;
    color: var(--color-ink);
  }
  .feed h2 a:hover {
    color: var(--color-brand);
  }
  .feed__excerpt {
    margin: 0;
    color: var(--color-ink-soft);
  }
  .feed__pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }
</style>
