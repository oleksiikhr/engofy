---
import Layout from '../../../layouts/Layout.astro';
import { apiGetOrNull } from '../../../lib/api';
import { renderWordDetail } from '../../../lib/dictionary-detail';
import { getCurrentUser } from '../../../lib/session';
import type { WordDictionaryDetail } from '../../../lib/types';

const { lemma } = Astro.params;
const user = await getCurrentUser(Astro.request);

if (!user) {
  return Astro.redirect('/login');
}

const detail = lemma
  ? await apiGetOrNull<WordDictionaryDetail>(
      `/dictionary/words/${encodeURIComponent(lemma)}`,
      { request: Astro.request },
    )
  : null;

if (!detail) {
  return new Response('Not found', { status: 404 });
}

const detailHtml = renderWordDetail(detail);
---

<Layout title={`${detail.lemma} — Dictionary — Engofy`} user={user} active="dictionary">
  <p class="crumb"><a href="/dictionary">← Your dictionary</a></p>

  <header class="wd-head">
    <h1>{detail.lemma}</h1>
    {detail.frequencyRank && (
      <span class="wd-head__rank">Frequency rank #{detail.frequencyRank}</span>
    )}
  </header>

  <div id="wd-detail" set:html={detailHtml} />
</Layout>

<style is:global>
  .wd-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .wd-head__rank {
    font-size: 0.8rem;
    color: var(--color-ink-soft);
  }
  .wd-sense-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .wd-sense__head {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }
  .wd-sense__phonetic {
    margin: 0 0 0.3rem;
    color: var(--color-ink-faint);
  }
  .wd-sense__def {
    margin: 0 0 0.3rem;
  }
  .wd-sense__eg {
    margin: 0 0 0.5rem;
    color: var(--color-ink-soft);
    font-style: italic;
  }
  .wd-sense__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .wd-sense__actions form {
    display: inline;
  }
  .wd-sense__state {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .wd-sense__state--learned {
    color: var(--color-success);
  }
  .wd-sense__state--skipped {
    color: var(--color-warning);
  }
  .wd-irregular {
    margin-bottom: 1.5rem;
  }
  .wd-posts__empty {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }
  .wd-posts__list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 0.35rem;
  }
</style>
