---
import DictionaryDetailStyles from '../../../components/DictionaryDetailStyles.astro';
import Layout from '../../../layouts/Layout.astro';
import { apiGetOrNull } from '../../../lib/api';
import { renderPhraseDetail } from '../../../lib/dictionary-detail';
import { getCurrentUser } from '../../../lib/session';
import type { PhraseDictionaryDetail } from '../../../lib/types';

const { phrase } = Astro.params;
const user = await getCurrentUser(Astro.request);

if (!user) {
  return Astro.redirect('/login');
}

const detail = phrase
  ? await apiGetOrNull<PhraseDictionaryDetail>(
      `/dictionary/phrases/${encodeURIComponent(phrase)}`,
      { request: Astro.request },
    )
  : null;

if (!detail) {
  return new Response('Not found', { status: 404 });
}

const detailHtml = renderPhraseDetail(detail);
---

<Layout title={`${detail.phraseText} — Dictionary — Engofy`} user={user} active="dictionary" noindex>
  <p class="crumb"><a href="/dictionary">← Your dictionary</a></p>

  <header class="wd-head">
    <h1>{detail.phraseText}</h1>
  </header>

  <div id="pd-detail" set:html={detailHtml} />

  <DictionaryDetailStyles />
</Layout>
