---
import Layout from '../../layouts/Layout.astro';
import { buildActivityCalendar } from '../../lib/activity-calendar';
import { apiGet } from '../../lib/api';
import { getCurrentUser } from '../../lib/session';
import type { CefrLevel, Profile } from '../../lib/types';

const LEVELS: CefrLevel[] = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];

const user = await getCurrentUser(Astro.request);

const profile = user
  ? await apiGet<Profile>('/profile/progress', { request: Astro.request })
  : null;

const calendar = profile ? buildActivityCalendar(profile.activityDays) : [];

const cefrMax = profile
  ? Math.max(1, ...LEVELS.map((l) => profile.cefr[l] ?? 0))
  : 1;

const unlockedCount =
  profile?.categories.reduce(
    (n, c) => n + c.constructions.filter((x) => !x.locked).length,
    0,
  ) ?? 0;
const totalCount =
  profile?.categories.reduce((n, c) => n + c.constructions.length, 0) ?? 0;
---

<Layout title="Progress — Engofy" user={user} active="profile" noindex>
  <p class="back">
    <a class="btn btn--ghost btn--sm" href="/profile">← Profile</a>
  </p>
  <h1>Your progress</h1>

  {
    !user ? (
      <p>
        <a href="/login">Sign in</a> to track your streak, skills and levels.
      </p>
    ) : profile ? (
      <>
        <section class="stat-row">
          <div class="card stat">
            <p class="stat__num num">{profile.streak}</p>
            <p class="stat__label">day streak</p>
          </div>
          <div class="card stat">
            <p class="stat__num num">
              {unlockedCount}
              <span class="stat__den">/ {totalCount}</span>
            </p>
            <p class="stat__label">constructions started</p>
          </div>
        </section>

        <section class="card activity">
          <div class="section-head">
            <h2>Activity</h2>
            <span class="meta">Last 12 months</span>
          </div>
          <div class="activity__scroll">
            <div class="calendar" data-testid="activity-calendar">
              {calendar.map((day) => (
                <span
                  class:list={['hm', { l4: day.active }]}
                  data-date={day.date}
                  data-active={day.active ? 'true' : 'false'}
                  title={`${day.date}${day.active ? ' — reviewed' : ''}`}
                />
              ))}
            </div>
          </div>
        </section>

        <section class="card cefr">
          <h2>Cards by level</h2>
          <ul class="cefr-bars">
            {LEVELS.map((lvl) => {
              const n = profile.cefr[lvl] ?? 0;
              return (
                <li class="cefr-bar" data-testid={`cefr-${lvl}`}>
                  <span class="badge badge--solid cefr-bar__label">{lvl}</span>
                  <span class="bar">
                    <i style={`width: ${Math.round((n / cefrMax) * 100)}%`} />
                  </span>
                  <span class="cefr-bar__n num">{n}</span>
                </li>
              );
            })}
          </ul>
        </section>

        <section class="skills">
          <h2>Grammar skills</h2>
          {profile.categories.map((cat) => (
            <details class="card skill-cat" open={cat.constructions.some((c) => !c.locked)}>
              <summary>{cat.name}</summary>
              <ul class="skill-list">
                {cat.constructions.map((con) => (
                  <li
                    class:list={['skill', { 'skill--locked': con.locked }]}
                    data-slug={con.slug}
                  >
                    <a href={`/grammar/${con.slug}`} class="skill__name">
                      {con.cefrLevel && <span class="badge">{con.cefrLevel}</span>}
                      {con.name}
                    </a>
                    {con.locked ? (
                      <span class="tag tag--muted skill__locked">Locked</span>
                    ) : (
                      <span class="skill__mastery">
                        <span class="bar tone-blue">
                          <i style={`width: ${con.masteryScore}%`} />
                        </span>
                        <span class="num">{con.masteryScore}</span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </section>
      </>
    ) : null
  }
</Layout>

<script>
  // Newest weeks sit at the right edge; start the scroller there.
  const scroller = document.querySelector<HTMLElement>('.activity__scroll');
  if (scroller) {
    scroller.scrollLeft = scroller.scrollWidth;
  }
</script>

<style>
  h2 {
    font-weight: 800;
  }
  .back {
    margin: 0 0 0.5rem -0.9rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.875rem;
  }
  .section-head h2 {
    margin: 0;
  }
  .activity,
  .cefr {
    margin-bottom: 1.5rem;
  }
  .activity__scroll {
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }
  .calendar {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 0.875rem);
    grid-auto-columns: 0.875rem;
    gap: 4px;
    width: max-content;
  }
  .cefr h2 {
    margin-bottom: 0.875rem;
  }
  .cefr-bars {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .cefr-bar {
    display: grid;
    grid-template-columns: 3rem 1fr 2.5rem;
    align-items: center;
    gap: 0.75rem;
  }
  .cefr-bar__label {
    text-align: center;
  }
  .cefr-bar__n {
    text-align: right;
    font-weight: 800;
    font-size: 0.9rem;
  }
  .skills h2 {
    margin-bottom: 0.875rem;
  }
  .skill-cat {
    margin-bottom: 0.75rem;
    padding: 1rem 1.25rem;
  }
  .skill-cat summary {
    cursor: pointer;
    font-weight: 800;
    font-family: var(--font-display);
  }
  @media (max-width: 40rem) {
    .skill-cat summary {
      padding-block: 0.5rem;
    }
    .skill__name {
      min-height: 2rem;
    }
  }
  .skill-list {
    list-style: none;
    padding: 0.875rem 0 0;
    margin: 0;
    display: grid;
    gap: 0.625rem;
  }
  .skill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .skill__name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: none;
  }
  .skill__name:hover {
    color: var(--color-brand-strong);
  }
  .skill--locked .skill__name {
    color: var(--color-ink-faint);
  }
  .skill__mastery {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 9rem;
    font-weight: 800;
    font-size: 0.9rem;
  }
  .skill__mastery .bar {
    flex: 1;
  }
  .skill__locked {
    margin-left: auto;
  }
</style>
