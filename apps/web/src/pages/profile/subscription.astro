---
import Layout from '../../layouts/Layout.astro';
import { apiGet, apiPatch } from '../../lib/api';
import { formatDate } from '../../lib/format-date';
import { getCurrentUser } from '../../lib/session';
import type { ProfileSubscription } from '../../lib/types';

const MAX_DAILY_NEW_CARD_LIMIT = 100;

const user = await getCurrentUser(Astro.request);

// Plain form POST + redirect (no client JS), same pattern as the daily-goal
// form on `/profile`: Premium-only new-card-limit override
// (`PATCH /profile/daily-new-card-limit`).
let limitError = false;
if (user && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const limit = Number(form.get('dailyNewCardLimit'));
  try {
    if (
      Number.isInteger(limit) &&
      limit >= 1 &&
      limit <= MAX_DAILY_NEW_CARD_LIMIT
    ) {
      await apiPatch(
        '/profile/daily-new-card-limit',
        { dailyNewCardLimit: limit },
        { request: Astro.request },
      );
      return Astro.redirect('/profile/subscription');
    }
    limitError = true;
  } catch {
    limitError = true;
  }
}

const sub = user
  ? await apiGet<ProfileSubscription>('/profile/subscription', {
      request: Astro.request,
    })
  : null;

const isPremium = sub?.plan === 'premium' && sub.active;
const usedPct =
  sub?.cardLimit != null
    ? Math.min(100, Math.round((sub.cardsUsed / sub.cardLimit) * 100))
    : 0;
---

<Layout title="Subscription — Engofy" user={user} active="profile" noindex>
  <p class="back">
    <a class="btn btn--ghost btn--sm" href="/profile">← Profile</a>
  </p>
  <h1>Subscription</h1>

  {
    !user ? (
      <p>
        <a href="/login">Sign in</a> to see your plan.
      </p>
    ) : sub ? (
      <>
        <section
          class:list={['card', 'plan', { 'card--hi': isPremium }]}
          data-testid="plan-card"
        >
          <div class="plan__head">
            <h2>{isPremium ? 'Premium' : 'Free'}</h2>
            <span class:list={['tag', isPremium ? 'tone-green' : 'tag--muted']}>
              {isPremium ? 'Active' : 'Current plan'}
            </span>
          </div>
          <p class="plan__detail">
            {
              isPremium
                ? sub.currentPeriodEnd
                  ? `Active until ${formatDate(sub.currentPeriodEnd)}.`
                  : 'Active.'
                : 'You are on the free plan.'
            }
          </p>
        </section>

        <section class="card plan" data-testid="card-usage">
          <h2>Saved cards</h2>
          {
            sub.cardLimit == null ? (
              <p class="plan__detail">
                <span class="num">{sub.cardsUsed}</span> saved — unlimited on
                Premium.
              </p>
            ) : (
              <>
                <p class="plan__detail">
                  <span class="num">
                    {sub.cardsUsed} / {sub.cardLimit}
                  </span>{' '}
                  cards used
                </p>
                <span class="bar plan__bar">
                  <i style={`width: ${usedPct}%`} />
                </span>
              </>
            )
          }
        </section>

        <section class="card plan" data-testid="daily-new-card-limit">
          <h2>New cards per day</h2>
          {
            isPremium ? (
              <>
                <p class="plan__detail">
                  How many new words/phrases the reader and practice queue
                  introduce each day.
                </p>
                <form
                  method="post"
                  class="limit-form"
                  data-testid="daily-new-card-limit-form"
                >
                  <input
                    class="input"
                    type="number"
                    name="dailyNewCardLimit"
                    min="1"
                    max={MAX_DAILY_NEW_CARD_LIMIT}
                    step="1"
                    required
                    value={sub.dailyNewCardLimit}
                  />
                  <button class="btn" type="submit">
                    Save
                  </button>
                </form>
                {limitError && (
                  <p class="form-error" role="alert">
                    Enter a whole number from 1 to {MAX_DAILY_NEW_CARD_LIMIT}.
                  </p>
                )}
              </>
            ) : (
              <p class="plan__detail">
                <span class="num">{sub.dailyNewCardLimit}</span> new cards a
                day — upgrade to Premium to raise this.
              </p>
            )
          }
        </section>

        <p>
          <a class="btn" href="/pricing">
            {isPremium ? 'View plans' : 'Upgrade to Premium'}
          </a>
        </p>
      </>
    ) : null
  }
</Layout>

<style>
  h2 {
    font-weight: 800;
  }
  .back {
    margin: 0 0 0.5rem -0.9rem;
  }
  .plan {
    margin-bottom: 1rem;
  }
  .plan h2 {
    margin: 0 0 0.5rem;
  }
  .plan__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .plan__detail {
    margin: 0;
    color: var(--color-ink-soft);
  }
  .plan__bar {
    margin-top: 0.75rem;
  }
  .limit-form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .limit-form input {
    width: 5.5rem;
  }
  .form-error {
    margin: 0.75rem 0 0;
    color: var(--color-danger);
    font-size: 0.9rem;
    font-weight: 700;
  }
</style>
