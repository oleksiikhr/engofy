---
import Layout from '../layouts/Layout.astro';
import { apiGet } from '../lib/api';
import { renderDictionaryResults } from '../lib/dictionary-list';
import { getCurrentUser } from '../lib/session';
import type { DictionaryResponse } from '../lib/types';

const STATES = [
  { value: '', label: 'All statuses' },
  { value: 'learning', label: 'Learning' },
  { value: 'learned', label: 'Learned' },
  { value: 'skipped', label: 'Skipped' },
] as const;

const user = await getCurrentUser(Astro.request);

const state = Astro.url.searchParams.get('state') ?? '';
const search = Astro.url.searchParams.get('search') ?? '';
const query = { state, search };

let resultsHtml = '';
if (user) {
  const qs = Astro.url.searchParams.toString();
  const view = await apiGet<DictionaryResponse>(
    `/dictionary${qs ? `?${qs}` : ''}`,
    { request: Astro.request },
  );
  resultsHtml = renderDictionaryResults(view, query);
}
---

<Layout title="Dictionary — Engofy" user={user} active="dictionary" noindex>
  <h1>Your dictionary</h1>

  {
    !user ? (
      <p>
        <a href="/login">Sign in</a> to see the words and phrases you've saved.
      </p>
    ) : (
      <>
        <form
          id="dict-filters"
          method="get"
          action="/dictionary"
          hx-get="/partials/dictionary"
          hx-target="#dict-results"
          hx-swap="innerHTML"
          hx-push-url="true"
          hx-trigger="input changed delay:400ms, change"
          class="dict-controls"
        >
          <div class="dict-search">
            <svg
              class="ic"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="10" cy="10" r="6" />
              <path d="M20 20l-5.5-5.5" />
            </svg>
            <input
              id="dict-search"
              class="input"
              name="search"
              type="search"
              value={search}
              placeholder="Search words, phrases…"
              aria-label="Search your dictionary"
            />
          </div>
          <select
            id="dict-state"
            class="input"
            name="state"
            aria-label="Filter by status"
          >
            {STATES.map((s) => (
              <option value={s.value} selected={s.value === state}>
                {s.label}
              </option>
            ))}
          </select>
        </form>

        <div class="dict-skeleton" aria-hidden="true">
          {[0, 1, 2].map(() => (
            <div class="card dict-skeleton__card">
              <span class="skeleton" style="width: 30%; height: 1rem" />
              <span class="skeleton" style="width: 55%; height: 1.75rem" />
              <span class="skeleton" style="height: 2.5rem" />
            </div>
          ))}
        </div>
        <div id="dict-results" set:html={resultsHtml} />
      </>
    )
  }
</Layout>

<style is:global>
  .dict-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .dict-search {
    position: relative;
    flex: 1 1 16rem;
  }
  .dict-search .ic {
    position: absolute;
    top: 50%;
    left: 0.875rem;
    transform: translateY(-50%);
    color: var(--color-ink-faint);
    pointer-events: none;
  }
  .dict-search .input {
    padding-left: 2.5rem;
  }
  .dict-controls select.input {
    width: auto;
    min-width: 11rem;
  }
  .dict-empty {
    text-align: center;
    color: var(--color-ink-soft);
  }
  .dict-empty p {
    margin: 0;
  }
  .dict-list,
  .dict-skeleton {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
  }
  .dict-entry {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .dict-entry__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .dict-entry__title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 0.625rem;
  }
  .dict-entry__term {
    color: var(--color-ink);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .dict-entry__term:hover {
    color: var(--color-brand-strong);
  }
  .dict-entry__def,
  .dict-entry__eg,
  .dict-entry__posts {
    margin: 0;
  }
  .dict-entry__def {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .dict-entry__eg {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-ink-soft);
  }
  .dict-entry__posts {
    margin-top: auto;
  }
  .dict-more {
    margin-top: 1.5rem;
    text-align: center;
  }
  .dict-skeleton {
    display: none;
  }
  .dict-skeleton__card {
    display: grid;
    gap: 0.75rem;
  }
  /* Skeleton cards stand in for the results while a filter request is in
     flight — delayed, so a fast response never flashes them. */
  #dict-results {
    overflow: hidden;
  }
  #dict-filters.htmx-request ~ .dict-skeleton {
    display: grid;
    opacity: 0;
    animation: dict-fade-in 0s 0.2s forwards;
  }
  #dict-filters.htmx-request ~ #dict-results {
    animation: dict-fade-out 0s 0.2s forwards;
  }
  @keyframes dict-fade-in {
    to {
      opacity: 1;
    }
  }
  @keyframes dict-fade-out {
    to {
      opacity: 0;
      max-height: 0;
    }
  }
</style>
