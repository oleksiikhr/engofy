---
import Layout from '../layouts/Layout.astro';
import { apiGet } from '../lib/api';
import { renderDictionaryResults } from '../lib/dictionary-list';
import { getCurrentUser } from '../lib/session';
import type { DictionaryResponse } from '../lib/types';

const STATES = [
  { value: '', label: 'All statuses' },
  { value: 'learning', label: 'Learning' },
  { value: 'learned', label: 'Learned' },
  { value: 'skipped', label: 'Skipped' },
] as const;

const user = await getCurrentUser(Astro.request);

const state = Astro.url.searchParams.get('state') ?? '';
const search = Astro.url.searchParams.get('search') ?? '';
const query = { state, search };

let resultsHtml = '';
if (user) {
  const qs = Astro.url.searchParams.toString();
  const view = await apiGet<DictionaryResponse>(
    `/dictionary${qs ? `?${qs}` : ''}`,
    { request: Astro.request },
  );
  resultsHtml = renderDictionaryResults(view, query);
}
---

<Layout title="Dictionary — Engofy" user={user} active="dictionary">
  <h1>Your dictionary</h1>

  {
    !user ? (
      <p>
        <a href="/login">Sign in</a> to see the words and phrases you've saved.
      </p>
    ) : (
      <>
        <form
          id="dict-filters"
          method="get"
          action="/dictionary"
          hx-get="/partials/dictionary"
          hx-target="#dict-results"
          hx-swap="innerHTML"
          hx-push-url="true"
          hx-trigger="input changed delay:400ms, change"
          class="dict-controls"
        >
          <input
            id="dict-search"
            name="search"
            type="search"
            value={search}
            placeholder="Search words, phrases…"
            aria-label="Search your dictionary"
          />
          <select id="dict-state" name="state" aria-label="Filter by status">
            {STATES.map((s) => (
              <option value={s.value} selected={s.value === state}>
                {s.label}
              </option>
            ))}
          </select>
        </form>

        <div id="dict-results" set:html={resultsHtml} />
      </>
    )
  }
</Layout>

<style is:global>
  .dict-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }
  .dict-controls input,
  .dict-controls select {
    font: inherit;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .dict-controls input {
    flex: 1 1 16rem;
  }
  .dict-empty {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }
  .dict-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .dict-entry__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
  }
  .dict-entry__term {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .dict-entry__senses {
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }
  .dict-entry__state {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .dict-entry__state--learned {
    color: var(--color-success);
  }
  .dict-entry__state--skipped {
    color: var(--color-warning);
  }
  .dict-entry__pos {
    margin: 0 0 0.3rem;
    font-size: 0.8rem;
    color: var(--color-ink-faint);
  }
  .dict-entry__def {
    margin: 0 0 0.3rem;
  }
  .dict-entry__eg {
    margin: 0 0 0.3rem;
    color: var(--color-ink-soft);
    font-style: italic;
  }
  .dict-entry__posts {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .dict-more {
    margin-top: 1rem;
  }
</style>
