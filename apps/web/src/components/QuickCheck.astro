---
import type { QuickCheckStep } from '../lib/quick-check-steps';

// The reader's Quick check card, server-rendered: intro, one screen per step
// and the summary. `lib/quick-check.ts` drives which screen is visible and
// grades the answers.
interface Props {
  steps: QuickCheckStep[];
  postTitle: string | null;
  summaryText: string;
  signedIn: boolean;
  streak: number;
  dueCount: number;
  fromHome: boolean;
}

const { steps, postTitle, summaryText, signedIn, streak, dueCount, fromHome } =
  Astro.props;

const total = steps.length;
const countOf = (kind: QuickCheckStep['kind']) =>
  steps.filter((s) => s.kind === kind).length;
const kinds = [
  { kind: 'choose', label: 'Choose the form', tone: 'tone-blue' },
  { kind: 'recall', label: 'Recall a word', tone: 'tone-amber' },
  { kind: 'match', label: 'Match pairs', tone: 'tone-green' },
  { kind: 'type', label: 'Type the answer', tone: 'tone-pink' },
  { kind: 'order', label: 'Put in order', tone: 'tone-brand' },
] as const;
const RATINGS = [
  { rating: 'again', label: 'Again', tone: 'tone-danger' },
  { rating: 'hard', label: 'Hard', tone: 'tone-amber' },
  { rating: 'good', label: 'Good', tone: 'tone-green' },
  { rating: 'easy', label: 'Easy', tone: 'tone-blue' },
] as const;
---

<div class="qc" data-qc>
  {
    total > 0 && (
      <div class="qc__screen" data-qc-screen="intro" tabindex="-1">
        <div class="qc__top">
          <span class="eyebrow">Quick check</span>
          <button type="button" class="qc__close" data-qc-skip aria-label="Skip quick check">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
        </div>
        <div class="qc__intro">
          <h2 class="qc__title">
            One minute, {total} quick question{total === 1 ? '' : 's'}.
          </h2>
          <p class="qc__note">From “{postTitle ?? 'this text'}”. Skip any time.</p>
        </div>
        {kinds
          .filter(({ kind }) => countOf(kind) > 0)
          .map(({ kind, label, tone }) => (
            <div class="card qc__kind">
              <span class={`tag ${tone}`}>{countOf(kind)}×</span>
              <b>{label}</b>
            </div>
          ))}
        <div class="qc__actions">
          <button type="button" class="btn btn--lg" data-qc-start>Start</button>
          <button type="button" class="btn btn--sm btn--ghost" data-qc-skip>Skip for now</button>
        </div>
      </div>
    )
  }
  {
    steps.map((step, si) => (
      <div
        class="qc__screen"
        data-qc-screen="question"
        data-qc-kind={step.kind}
        data-answer-index={step.kind === 'choose' ? String(step.answerIndex) : undefined}
        data-card-id={step.kind === 'recall' ? step.cardId : undefined}
        data-answer={step.kind === 'type' ? step.answer : step.kind === 'order' ? step.answerText : undefined}
        data-order={step.kind === 'order' ? JSON.stringify(step.order) : undefined}
        tabindex="-1"
        hidden
      >
        <div class="qc__top">
          <button type="button" class="qc__close" data-qc-skip aria-label="Skip quick check">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
          <div class="qc__prog" role="img" aria-label={`Question ${si + 1} of ${total}`}>
            {steps.map((_, i) => (
              <i class:list={{ done: i < si, cur: i === si }} />
            ))}
          </div>
          <span class="meta num">{si + 1}/{total}</span>
        </div>

        {step.kind === 'choose' && (
          <>
            <p class="eyebrow qc__kicker tone-blue">Choose the form</p>
            <p class="qc__prompt">{step.before}<span class="qc__blank" data-qc-blank>&nbsp;</span>{step.after}</p>
            <div class="qc__options" role="group" aria-label="Options">
              {step.options.map((opt, i) => (
                <button type="button" class="qc__opt" data-option={String(i)} data-text={opt} aria-pressed="false">
                  <kbd>{i + 1}</kbd>
                  <svg class="ic qc__mark qc__mark--ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                  <svg class="ic qc__mark qc__mark--bad" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                  {opt}
                </button>
              ))}
            </div>
            <div class="alert qc__feedback" data-qc-feedback role="status" hidden>
              <div>
                <b data-qc-verdict />
                {step.explanations.map((text, i) => (
                  <p class="qc__explanation" data-explanation={String(i)} hidden>
                    <b>{step.options[i]}</b> {text}
                  </p>
                ))}
              </div>
            </div>
            <div class="qc__actions">
              <button type="button" class="btn btn--lg" data-qc-check disabled>Check</button>
              <button type="button" class="btn btn--lg" data-qc-next hidden>
                {si === total - 1 ? 'See results' : 'Continue'}
              </button>
            </div>
          </>
        )}

        {step.kind === 'recall' && (
          <>
            <p class="eyebrow qc__kicker tone-amber">Recall a word</p>
            <div class="qc__fcard">
              <span class="tag tone-amber">{step.type === 'word' ? 'Word' : 'Phrase'}</span>
              <p class="qc__term">{step.term}</p>
              {step.phonetic && <p class="meta">{step.phonetic}</p>}
              <div class="qc__reveal" data-qc-answer hidden>
                <p class="qc__definition">{step.definition}</p>
                {step.context && <p class="qc__context">{step.context}</p>}
              </div>
            </div>
            <div class="qc__actions">
              <button type="button" class="btn btn--lg btn--sec" data-qc-reveal>
                Show answer <kbd aria-hidden="true">␣</kbd>
              </button>
              <div class="qc__rate" data-qc-rate hidden>
                <p class="eyebrow">How well did you know it?</p>
                <div class="qc__rates">
                  {RATINGS.map((r, i) => (
                    <button type="button" class={`qc__rating ${r.tone}`} data-rating={r.rating} aria-keyshortcuts={String(i + 1)}>
                      {r.label}<kbd aria-hidden="true">{i + 1}</kbd>
                    </button>
                  ))}
                </div>
              </div>
            </div>
          </>
        )}

        {step.kind === 'match' && (
          <>
            <div class="qc__row">
              <p class="eyebrow qc__kicker tone-green">Match the pairs</p>
              <span class="meta num" data-qc-match-count role="status">0 of {step.pairs.length}</span>
            </div>
            <div class="qc__match" data-qc-match={String(step.pairs.length)}>
              <div class="qc__match-col" role="group" aria-label="Words">
                {step.pairs.map((pair) => (
                  <button type="button" class="qc__opt qc__opt--match" data-match-term={pair.id} aria-pressed="false">{pair.term}</button>
                ))}
              </div>
              <div class="qc__match-col" data-match-meanings role="group" aria-label="Meanings">
                {step.pairs.map((pair) => (
                  <button type="button" class="qc__opt qc__opt--match" data-match-meaning={pair.id} aria-pressed="false">{pair.meaning}</button>
                ))}
              </div>
            </div>
            <p class="qc__note qc__hint">Pick a word, then its meaning.</p>
            <div class="qc__actions">
              <button type="button" class="btn btn--lg" data-qc-next hidden>
                {si === total - 1 ? 'See results' : 'Continue'}
              </button>
            </div>
          </>
        )}

        {step.kind === 'type' && (
          <>
            <p class="eyebrow qc__kicker tone-pink">Type the answer</p>
            {step.hint && <p class="qc__note">{step.hint}</p>}
            {step.variant === 'fill_blank' ? (
              <p class="qc__prompt">{step.before}<input class="qc__input qc__input--inline" data-qc-input type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Missing word" />{step.after}</p>
            ) : (
              <>
                <p class="qc__prompt">{step.before}</p>
                <input class="qc__input" data-qc-input type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Correct form" />
              </>
            )}
            {step.bank.length > 0 && (
              <div class="qc__bank" role="group" aria-label="Word bank">
                {step.bank.map((opt) => (
                  <button type="button" class="qc__opt qc__opt--chip" data-qc-bank>{opt}</button>
                ))}
              </div>
            )}
            <div class="alert qc__feedback" data-qc-feedback role="status" hidden>
              <div>
                <b data-qc-verdict />
                <p class="qc__explanation" data-qc-note hidden />
              </div>
            </div>
            <div class="qc__actions">
              <button type="button" class="btn btn--lg" data-qc-check disabled>Check</button>
              <button type="button" class="btn btn--lg" data-qc-next hidden>
                {si === total - 1 ? 'See results' : 'Continue'}
              </button>
            </div>
          </>
        )}

        {step.kind === 'order' && (
          <>
            <p class="eyebrow qc__kicker tone-brand">Put in order</p>
            <p class="qc__note">Tap the words in the order of the sentence.</p>
            <div class="qc__bank" role="group" aria-label="Words">
              {step.tokens.map((token, slot) => (
                <button type="button" class="qc__opt qc__opt--chip" data-order-chip={String(slot)}>{token}</button>
              ))}
            </div>
            <p class="qc__prompt qc__build" data-qc-build aria-live="polite">&nbsp;</p>
            <div class="alert qc__feedback" data-qc-feedback role="status" hidden>
              <div>
                <b data-qc-verdict />
                <p class="qc__explanation" data-qc-note hidden />
              </div>
            </div>
            <div class="qc__actions">
              <button type="button" class="btn btn--sm btn--ghost" data-qc-reset>Reset</button>
              <button type="button" class="btn btn--lg" data-qc-next hidden>
                {si === total - 1 ? 'See results' : 'Continue'}
              </button>
            </div>
          </>
        )}
      </div>
    ))
  }
  <div class="qc__screen" data-qc-screen="summary" tabindex="-1" hidden={total > 0}>
    <div class="qc__done">
      <div class="qc__ring" data-qc-ring hidden>
        <svg width="112" height="112" viewBox="0 0 112 112" role="img" aria-label="Score">
          <circle cx="56" cy="56" r="48" fill="none" stroke="var(--color-border)" stroke-width="12" />
          <circle data-qc-ring-bar cx="56" cy="56" r="48" fill="none" stroke="var(--color-success)" stroke-width="12" stroke-linecap="round" stroke-dasharray="0 302" transform="rotate(-90 56 56)" />
          <text data-qc-ring-text x="56" y="64" text-anchor="middle" font-size="26" font-weight="800" fill="var(--color-ink)" font-family="inherit"></text>
        </svg>
      </div>
      <h2 class="qc__title" data-qc-title>You finished this text.</h2>
      <p class="qc__note">{summaryText}<span data-added></span></p>
    </div>
    {
      signedIn && (
        <div class="qc__tiles">
          <div class="card card--soft qc__tile tone-amber">
            <b class="qc__tile-num num">
              <svg class="ic" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c1 4-3 5-3 9a3 3 0 0 0 6 0c1 1 2 2 2 4a5 5 0 0 1-10 0c0-5 4-6 5-13z" /></svg>
              {streak}
            </b>
            <span class="meta">Day streak</span>
          </div>
          <div class="card card--soft qc__tile tone-brand">
            <b class="qc__tile-num num" data-qc-due={String(dueCount)}>{dueCount}</b>
            <span class="meta">Due from this text</span>
          </div>
        </div>
      )
    }
    <div class="qc__actions qc__actions--end">
      {
        fromHome && signedIn && (
          <a class="btn btn--lg" href="/">Continue to today's practice</a>
        )
      }
      {
        !fromHome && (
          <a class="btn btn--lg" href="/practice" data-qc-practice hidden={dueCount === 0}>
            Practice {dueCount} card{dueCount === 1 ? '' : 's'} from this text
          </a>
        )
      }
      <a class="btn btn--sm btn--ghost" href="/posts">Back to posts</a>
    </div>
  </div>
</div>
