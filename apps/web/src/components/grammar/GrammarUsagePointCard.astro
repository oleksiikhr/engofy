---
// One usage point's card: badge/guideword, explanation, examples, learner
// actions, exercises. Shared by GrammarUsagePoints (the generic bottom list)
// and handcrafted pages, which drop it inline inside the GrammarSection its
// rule belongs to instead of leaving it stranded in the bottom list.
import { usageActionsHtml } from '../../lib/grammar-usage-actions';
import { NATIVE_LANG_LABEL, nativeLang } from '../../lib/native-lang';
import type { GrammarConstructionUsagePoint } from '../../lib/types';
import { usagePointExercisesHtml } from '../../lib/usage-point-exercises';
import GrammarContrast from './GrammarContrast.astro';

interface Props {
  usagePoint: GrammarConstructionUsagePoint;
}

const { usagePoint: up } = Astro.props;
// Deep-link target for the Reader popup's "Practice" button
// (`lib/reader-lexicon.ts`'s `practiceHref`); null for a usage point added
// from a non-EGP source, which has no anchor.
const anchorId =
  up.egpIndex == null ? undefined : `usage-point-${up.egpIndex}`;
// The native-language explanation stands in for the English one when the
// learner picks it; a card with no translation has no switch and always shows
// English. Only the native language reaches the HTML, not every translation.
const native = nativeLang();
const nativeExplanation = up.explanation
  ? up.translations[native]?.explanation
  : null;
---

<div class="usage-item card" data-state={up.state} id={anchorId}>
  <div class="usage-item__head">
    <span class="badge">{up.cefrLevel}</span>
    <span class="usage-item__guide">{up.guideword}</span>
    {
      nativeExplanation && (
        <div
          class="usage-item__lang"
          role="group"
          aria-label="Explanation language"
        >
          <button type="button" data-usage-lang="en" aria-pressed="true">
            EN
          </button>
          <button type="button" data-usage-lang="native" aria-pressed="false">
            {NATIVE_LANG_LABEL[native]}
          </button>
        </div>
      )
    }
  </div>
  <p class="usage-item__can">
    <span class="usage-item__en">{up.explanation ?? up.canDoStatement}</span>
    {
      nativeExplanation && (
        <span class="usage-item__native" lang={native}>
          {nativeExplanation}
        </span>
      )
    }
  </p>
  {up.explanation && <p class="usage-item__cando">{up.canDoStatement}</p>}
  {
    up.examples.length > 0 && (
      <div data-testid="usage-examples">
        <GrammarContrast good={up.examples} />
      </div>
    )
  }
  <Fragment
    set:html={usageActionsHtml(
      up.grammarUsagePointId,
      up.state,
      undefined,
      up.assumedKnown,
    )}
  />
  <Fragment set:html={usagePointExercisesHtml(up.exercises)} />
</div>

<style>
  .usage-item {
    margin: 0 0 1rem;
    padding: 1.125rem 1.25rem;
  }
  .usage-item[data-state='learning'] {
    border-color: var(--color-brand);
  }
  .usage-item[data-state='learned'] {
    border-color: var(--color-success);
  }
  .usage-item[data-state='skipped'] {
    border-color: var(--color-warning);
  }
  .usage-item__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .usage-item__guide {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .usage-item__can {
    margin: 0 0 0.5rem;
    font-weight: 800;
  }
  /* Language comes from <html data-popup-lang> (boot script, before first
     paint); aria-pressed is only synced for assistive tech afterwards. */
  .usage-item__native {
    display: none;
  }
  :global(:root[data-popup-lang='native']) .usage-item__native {
    display: inline;
  }
  :global(:root[data-popup-lang='native'])
    .usage-item__en:has(~ .usage-item__native) {
    display: none;
  }
  .usage-item__lang {
    display: inline-flex;
    margin-left: auto;
    padding: 2px;
    border-radius: 999px;
    background: var(--color-paper-soft);
  }
  .usage-item__lang button {
    min-width: 2.25rem;
    padding: 0.2rem 0.55rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-soft);
    font-size: 0.72rem;
    font-weight: 800;
    cursor: pointer;
  }
  :global(:root:not([data-popup-lang='native']))
    .usage-item__lang
    [data-usage-lang='en'],
  :global(:root[data-popup-lang='native'])
    .usage-item__lang
    [data-usage-lang='native'] {
    background: var(--color-brand-wash);
    color: var(--color-brand-strong);
  }
  .usage-item__cando {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--color-ink-faint);
  }
  .upe {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .upe__title {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    font-weight: 800;
  }
  .upe__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .upe__item {
    padding: 1rem;
  }
</style>

<!-- The action row is injected via set:html (shared with the HTMX partial),
     so its selectors must be global. -->
<style is:global>
  .gup-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .gup-actions form {
    margin: 0;
  }
  .gup-state {
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--color-paper-soft);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-ink-soft);
  }
  .gup-state--learning {
    background: var(--color-brand-wash);
    color: var(--color-brand-strong);
  }
  .gup-state--learned {
    background: var(--color-success-wash);
    color: var(--color-success-ink);
  }
  .gup-state--assumed {
    background: var(--color-paper-soft);
    color: var(--color-ink-faint);
  }
  .gup-state--skipped {
    background: var(--color-warning-wash);
    color: var(--color-warning-ink);
  }
</style>

<script>
  import { initGrammarLangToggle } from '../../lib/grammar-lang-toggle';
  import { initUsagePointExercises } from '../../lib/usage-point-exercises-client';

  initUsagePointExercises(document);
  initGrammarLangToggle(document);
</script>
