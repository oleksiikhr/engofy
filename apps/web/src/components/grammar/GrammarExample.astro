---
// An example sentence, optionally with a short note under it. The handcrafted
// page wraps the target word/phrase in <mark> itself, e.g.
// `I was <mark>alone</mark> at the bus station.` — that markup lands in the
// parent page's astro scope, not this component's, so it's styled by a
// global rule below rather than a scoped one.
interface Props {
  note?: string;
}

const { note } = Astro.props;
---

<figure class="gp-example">
  <blockquote><slot /></blockquote>
  {note && <figcaption>{note}</figcaption>}
</figure>

<style>
  .gp-example {
    margin: 0 0 0.75rem;
    padding: 0.625rem 1rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-highlight);
    border-radius: 0 var(--radius-control) var(--radius-control) 0;
    background: var(--color-highlight-wash);
  }
  .gp-example blockquote {
    margin: 0;
    font-weight: 700;
  }
  .gp-example figcaption {
    margin-top: 0.125rem;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
</style>

<style is:global>
  .gp-example mark {
    background: var(--color-gram);
    color: inherit;
    padding: 0.05em 0.2em;
    border-radius: 0.25em;
  }
</style>
