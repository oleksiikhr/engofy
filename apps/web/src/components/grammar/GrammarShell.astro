---
import Layout from '../../layouts/Layout.astro';
import { grammarMetaDescription } from '../../lib/grammar-seo';
import { breadcrumbList, jsonLdGraph } from '../../lib/seo';
import {
  phraseLexiconEntries,
  wordLexiconEntries,
} from '../../lib/lexicon-data';
import { LEX_ROOT_END, LEX_ROOT_START, wrapLexWords } from '../../lib/lex-blocks';
import { escapeJson } from '../../lib/seo';
import { pagePracticeHtml } from '../../lib/usage-point-exercises';
import { publicOrigin } from '../../lib/site';
import type { CurrentUser, GrammarConstructionDetail } from '../../lib/types';
import GrammarSection from './GrammarSection.astro';
import GrammarSectionProgress from './GrammarSectionProgress.astro';
import GrammarUsagePoints from './GrammarUsagePoints.astro';

interface Section {
  id: string;
  title: string;
  open: boolean;
}

interface Props {
  con: GrammarConstructionDetail;
  user: CurrentUser | null;
  // Meta description; handcrafted pages set their own, otherwise it is derived
  // from the construction's data.
  description?: string;
  // Set by the pages under `src/grammar-pages/`; the generic fallback leaves it off.
  handcrafted?: boolean;
  // The GrammarSection ids/titles rendered in the default slot (Form, and
  // whatever else a handcrafted page writes), for the sticky checklist below.
  // "When it's used" and "Practice" are appended automatically — every page
  // has both.
  sections?: Section[];
  // grammarUsagePointIds a handcrafted page already rendered inline (via
  // GrammarUsagePointCard) next to the prose that explains them. Excluded
  // from the generic "When it's used" list below so the rule isn't explained
  // twice, once in prose and once as a disconnected card.
  inlineUsagePointIds?: string[];
}

const {
  con,
  user,
  description = grammarMetaDescription(con),
  handcrafted = false,
  sections = [],
  inlineUsagePointIds = [],
} = Astro.props;

const inlineIds = new Set(inlineUsagePointIds);
const remainingUsagePoints = con.usagePoints.filter(
  (up) => !inlineIds.has(up.grammarUsagePointId),
);

// Practice: the only place a page's exercises are listed, grouped by usage
// point; each card links to its group. GrammarUsagePointCard's script (every
// usage point is rendered as a card on the page) binds it.
const practiceHtml = pagePracticeHtml(con.usagePoints);

// A handcrafted page's words are wrapped server-side (known before paint),
// between markers `/grammar/lex-blocks.json` reads the page's text from.
const bodyHtml = handcrafted
  ? `${LEX_ROOT_START}${wrapLexWords(
      await Astro.slots.render('default'),
      con.lexicon?.blocks ?? {},
    )}${LEX_ROOT_END}`
  : null;
const lexiconJson = escapeJson({
  words: wordLexiconEntries(con.lexicon?.words ?? {}),
  phrases: phraseLexiconEntries(con.lexicon?.phrases ?? {}),
  grammar: {},
});

const progressSections: Section[] = [
  ...sections,
  ...(remainingUsagePoints.length > 0
    ? [{ id: 'use', title: "When it's used", open: false }]
    : []),
  { id: 'practice', title: 'Practice', open: false },
];

const jsonLd = jsonLdGraph([
  breadcrumbList(publicOrigin(Astro.url), [
    { name: 'Home', path: '/' },
    { name: 'Grammar', path: '/grammar' },
    { name: con.name, path: `/grammar/${encodeURIComponent(con.slug)}` },
  ]),
]);
---

<Layout
  title={`${con.name} — Grammar — Engofy`}
  description={description}
  user={user}
  active="grammar"
  measure={true}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <p class="crumb"><a href="/grammar">← Grammar reference</a></p>

  <header class="con-head">
    <p class="con-head__cat">{con.categoryName}</p>
    <h1>
      {con.cefrLevel && <span class="badge">{con.cefrLevel}</span>}
      {con.name}
    </h1>
    <div class="con-head__lede"><slot name="lede" /></div>
    {
      con.levelProgress && con.levelProgress.length > 0 && (
        <ul class="con-head__progress" data-testid="grammar-level-progress">
          {con.levelProgress.map((level) => (
            <li data-level={level.cefrLevel}>
              <span class="badge">{level.cefrLevel}</span>
              <span>
                {level.learnedCount}/{level.totalCount} learned
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </header>

  <GrammarSectionProgress sections={progressSections} />

  <div
    class="con-body"
    data-handcrafted={handcrafted ? 'true' : undefined}
    data-guest={user ? undefined : ''}
  >
    {bodyHtml === null ? <slot /> : <Fragment set:html={bodyHtml} />}
  </div>
  {
    bodyHtml !== null && (
      <script
        is:inline
        type="application/json"
        id="grammar-lexicon"
        set:html={lexiconJson}
      />
    )
  }

  <GrammarUsagePoints sectionId="use" usagePoints={remainingUsagePoints} />

  <GrammarSection title="Practice" id="practice" open={false}>
    {
      practiceHtml ? (
        <div data-testid="page-practice" set:html={practiceHtml} />
      ) : (
        <p>
          Exercises for this rule are on the way — we're building them as a
          separate step. For now, use the usage points above to track what
          you've learned.
        </p>
      )
    }
  </GrammarSection>
</Layout>

<script>
  import type { LexiconData } from '../../lib/reader-lexicon';
  import { initReaderPopup } from '../../lib/reader-popup';

  const body = document.querySelector<HTMLElement>('.con-body');
  const raw = document.getElementById('grammar-lexicon')?.textContent;
  if (body && raw) {
    const lexicon = JSON.parse(raw) as LexiconData;
    if (
      Object.keys(lexicon.words).length > 0 ||
      Object.keys(lexicon.phrases).length > 0
    ) {
      initReaderPopup(body, lexicon);
    }
  }
</script>

<style>
  .crumb {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 700;
  }
  .con-head {
    margin-bottom: 1.75rem;
  }
  .con-head__cat {
    margin: 0 0 0.375rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-strong);
  }
  .con-head h1 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    font-size: 2.25rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .con-head__lede :global(p) {
    margin: 0.75rem 0 0;
    font-size: 1.05rem;
    color: var(--color-ink-soft);
  }
  .con-head__progress {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-ink-soft);
  }
  .con-head__progress li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>

<!-- Building blocks for handcrafted pages (GrammarSection, GrammarTable, …)
     render inside the page's own scope, so the shared table rules live here. -->
<style is:global>
  .gp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .gp-table th,
  .gp-table td {
    text-align: left;
    vertical-align: top;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .gp-table th {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  /* Clickable words (lib/lex-blocks.ts), injected via set:html: a dotted
     underline only, so wrapping them never moves the text. */
  .con-body :is([data-word-definition-id], [data-phrase-id]) {
    cursor: pointer;
    text-decoration: underline dotted;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 3px;
  }
  .con-body :is([data-word-definition-id], [data-phrase-id]):hover,
  .con-body :is([data-word-definition-id], [data-phrase-id]):focus-visible {
    background: var(--color-word);
  }
  /* Practice groups are injected via set:html. */
  .upp__group + .upp__group {
    margin-top: 1.5rem;
  }
  .upp__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .upe__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .upe__item {
    padding: 1rem;
  }
</style>
