---
import Layout from '../../layouts/Layout.astro';
import { grammarMetaDescription } from '../../lib/grammar-seo';
import { breadcrumbList, jsonLdGraph } from '../../lib/seo';
import { publicOrigin } from '../../lib/site';
import type { CurrentUser, GrammarConstructionDetail } from '../../lib/types';
import GrammarUsagePoints from './GrammarUsagePoints.astro';

interface Props {
  con: GrammarConstructionDetail;
  user: CurrentUser | null;
  // Meta description; handcrafted pages set their own, otherwise it is derived
  // from the construction's data.
  description?: string;
  // Set by the pages under `src/grammar-pages/`; the generic fallback leaves it off.
  handcrafted?: boolean;
}

const {
  con,
  user,
  description = grammarMetaDescription(con),
  handcrafted = false,
} = Astro.props;

const jsonLd = jsonLdGraph([
  breadcrumbList(publicOrigin(Astro.url), [
    { name: 'Home', path: '/' },
    { name: 'Grammar', path: '/grammar' },
    { name: con.name, path: `/grammar/${encodeURIComponent(con.slug)}` },
  ]),
]);
---

<Layout
  title={`${con.name} — Grammar — Engofy`}
  description={description}
  user={user}
  active="grammar"
  measure={true}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <p class="crumb"><a href="/grammar">← Grammar reference</a></p>

  <header class="con-head">
    <p class="con-head__cat">{con.categoryName}</p>
    <h1>
      {con.cefrLevel && <span class="badge">{con.cefrLevel}</span>}
      {con.name}
    </h1>
    <div class="con-head__lede"><slot name="lede" /></div>
  </header>

  <div class="con-body" data-handcrafted={handcrafted ? 'true' : undefined}>
    <slot />
  </div>

  <GrammarUsagePoints
    usagePoints={con.usagePoints}
    levelProgress={con.levelProgress}
  />
</Layout>

<style>
  .crumb {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 700;
  }
  .con-head {
    margin-bottom: 1.75rem;
  }
  .con-head__cat {
    margin: 0 0 0.375rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-strong);
  }
  .con-head h1 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    font-size: 2.25rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .con-head__lede :global(p) {
    margin: 0.75rem 0 0;
    font-size: 1.05rem;
    color: var(--color-ink-soft);
  }
</style>

<!-- Building blocks for handcrafted pages (GrammarSection, GrammarTable, …)
     render inside the page's own scope, so the shared table rules live here. -->
<style is:global>
  .gp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .gp-table th,
  .gp-table td {
    text-align: left;
    vertical-align: top;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .gp-table th {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
</style>
