---
// Sticky checklist + track/fill progress bar (same visual pattern as
// practice.astro's daily-goal bar — .practice__goal-track/-fill) over the
// page's GrammarSection ids, so a long construction page reads as a few
// steps instead of one continuous scroll. `open` is known at render time
// (it's the same prop each GrammarSection got), so the initial fill/done
// state needs no client JS and there's nothing to jump into place after
// paint — the script below only reacts to the visitor's own clicks/toggles
// and to a deep link (`#usage-point-…`) into a closed section.
interface Section {
  id: string;
  title: string;
  open: boolean;
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
const total = sections.length;
const done = sections.filter((section) => section.open).length;
const pct = total > 0 ? Math.round((done / total) * 100) : 0;
---

{
  total > 0 && (
    <nav
      class="gp-progress"
      data-gp-progress
      aria-label="Sections on this page"
    >
      <div class="gp-progress__track">
        <div
          class="gp-progress__fill"
          data-gp-progress-fill
          style={`width:${pct}%`}
        />
      </div>
      <details class="gp-progress__more" data-gp-progress-more>
        <summary class="gp-progress__bar">
          <span class="gp-progress__current" data-gp-progress-current>
            {sections[0]?.title}
          </span>
          <span class="gp-progress__count" data-gp-progress-count>
            {done}/{total}
          </span>
        </summary>
        <ol class="gp-progress__list">
          {sections.map((section) => (
            <li>
              <a
                href={`#gp-section-${section.id}`}
                data-gp-progress-item={section.id}
                data-done={section.open ? 'true' : 'false'}
              >
                {section.title}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

<script>
  import {
    initGrammarSectionProgress,
    openHashTarget,
  } from '../../lib/grammar-section-progress';

  const nav = document.querySelector<HTMLElement>('[data-gp-progress]');
  if (nav) {
    initGrammarSectionProgress(nav);
  }
  openHashTarget();
  window.addEventListener('hashchange', openHashTarget);
</script>

<style>
  .gp-progress {
    position: sticky;
    top: 0;
    z-index: 5;
    margin: 0 0 1.5rem;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-border);
  }
  .gp-progress__track {
    height: 0.1875rem;
    background: var(--color-border);
  }
  .gp-progress__fill {
    height: 100%;
    background: var(--color-brand);
    transition: width 0.3s ease;
  }
  .gp-progress__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    height: 2.25rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .gp-progress__bar::-webkit-details-marker {
    display: none;
  }
  .gp-progress__current {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .gp-progress__count {
    flex: none;
    color: var(--color-ink-faint);
  }
  .gp-progress__count::after {
    content: ' ▾';
  }
  .gp-progress__more[open] .gp-progress__count::after {
    content: ' ▴';
  }
  /* Out of flow: opening the list overlays the page instead of pushing it. */
  .gp-progress__list {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 8px 16px rgb(0 0 0 / 0.08);
  }
  .gp-progress__list a {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.5rem 0 0.5rem 1.6rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-ink-faint);
  }
  .gp-progress__list a::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    border: 2px solid var(--color-border-strong);
  }
  .gp-progress__list a[data-done='true'] {
    color: var(--color-ink);
  }
  .gp-progress__list a[data-done='true']::before {
    border-color: var(--color-brand);
    background: var(--color-brand);
  }
</style>
