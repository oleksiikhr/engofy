---
// EN / native switch. The visible language is pure CSS off
// <html data-popup-lang>; initGrammarLangToggle persists the choice.
import { NATIVE_LANG_LABEL } from '../../lib/native-lang';
import { resolveNativeLang } from '../../lib/session';

const native = await resolveNativeLang(Astro.request);
---

<div class="lang-switch" role="group" aria-label="Explanation language">
  <button type="button" data-usage-lang="en" aria-pressed="true">EN</button>
  <button type="button" data-usage-lang="native" aria-pressed="false">
    {NATIVE_LANG_LABEL[native]}
  </button>
</div>

<style>
  .lang-switch {
    display: inline-flex;
    padding: 2px;
    border-radius: 999px;
    background: var(--color-paper-soft);
  }
  .lang-switch button {
    min-width: 2.25rem;
    padding: 0.2rem 0.55rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-soft);
    font-size: 0.72rem;
    font-weight: 800;
    cursor: pointer;
  }
  :global(:root:not([data-popup-lang='native']))
    .lang-switch
    [data-usage-lang='en'],
  :global(:root[data-popup-lang='native'])
    .lang-switch
    [data-usage-lang='native'] {
    background: var(--color-brand-wash);
    color: var(--color-brand-strong);
  }
</style>
