---
// The form of a construction as a row of parts: <GrammarFormula parts={['have / has', 'past participle']} />.
interface Props {
  label?: string;
  parts: string[];
}

const { label, parts } = Astro.props;
---

<p class="gp-formula">
  {label && <span class="gp-formula__label">{label}</span>}
  {
    parts.map((part, i) => (
      <>
        {i > 0 && <span class="gp-formula__plus">+</span>}
        <code class="gp-formula__part">{part}</code>
      </>
    ))
  }
</p>

<style>
  .gp-formula {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.625rem;
  }
  .gp-formula__label {
    min-width: 6rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .gp-formula__part {
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: var(--color-brand-wash);
    color: var(--color-brand-strong);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .gp-formula__plus {
    font-weight: 800;
    color: var(--color-ink-faint);
  }
</style>
