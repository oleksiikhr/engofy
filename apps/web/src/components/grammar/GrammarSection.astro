---
// One titled block of a handcrafted construction page.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="gp-section">
  <h2>{title}</h2>
  <slot />
</section>

<style>
  .gp-section {
    margin-bottom: 2rem;
  }
  .gp-section :global(h2) {
    margin: 0 0 0.75rem;
    font-size: 1.19rem;
    font-weight: 800;
  }
  .gp-section :global(p) {
    margin: 0 0 0.75rem;
  }
  .gp-section :global(code) {
    padding: 0.1rem 0.4rem;
    border-radius: 0.5rem;
    background: var(--color-paper-soft);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
