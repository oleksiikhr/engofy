---
// "Compare with" block: hardcoded links to sibling constructions, written
// directly in the page that uses it.
interface Props {
  items: { slug: string; name: string; note: string }[];
}

const { items } = Astro.props;
---

<aside class="gp-compare card card--soft" data-testid="grammar-compare">
  <h2>Compare with</h2>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={`/grammar/${item.slug}`}>{item.name}</a>
          <span>{item.note}</span>
        </li>
      ))
    }
  </ul>
</aside>

<style>
  .gp-compare {
    margin-bottom: 2rem;
  }
  .gp-compare h2 {
    margin: 0 0 0.75rem;
    font-size: 1.19rem;
    font-weight: 800;
  }
  .gp-compare ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .gp-compare li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem 0.75rem;
  }
  .gp-compare li a {
    font-weight: 800;
  }
  .gp-compare li span {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }
</style>
