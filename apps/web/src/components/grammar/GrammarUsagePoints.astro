---
// The generic "When it's used" list: usage points a handcrafted page hasn't
// already rendered inline next to its own prose (see GrammarShell's
// `inlineUsagePointIds`), or — for the generic /grammar/[slug] fallback —
// every usage point the construction has. Renders nothing when there's
// nothing left to show, so a handcrafted page that covers every usage point
// inline doesn't leave an empty section (and its own progress bar, if the
// construction has one, lives in GrammarShell's header instead).
//
// Closed by default; once opened, rules up to the base level (grammar-level.ts)
// are listed and harder ones sit behind a "More difficult cases" toggle. The
// source order (EGP: roughly the typical rule first) ranks within each group.
import { isHardLevel } from '../../lib/grammar-level';
import type { GrammarConstructionUsagePoint } from '../../lib/types';
import GrammarSection from './GrammarSection.astro';
import GrammarUsagePointCard from './GrammarUsagePointCard.astro';

interface Props {
  usagePoints: GrammarConstructionUsagePoint[];
  // Anchor for GrammarSectionProgress: renders as `gp-section-${sectionId}`.
  sectionId: string;
}

const { usagePoints, sectionId } = Astro.props;
const shown = usagePoints.filter((up) => !isHardLevel(up.cefrLevel));
const more = usagePoints.filter((up) => isHardLevel(up.cefrLevel));
const plural = (n: number) => (n === 1 ? '' : 's');
---

{
  usagePoints.length > 0 && (
    <GrammarSection
      title="When it's used"
      id={sectionId}
      open={false}
      meta={`${usagePoints.length} rule${plural(usagePoints.length)}`}
      testId="grammar-usage"
    >
      <ul class="usage-list">
        {shown.map((up) => (
          <li>
            <GrammarUsagePointCard usagePoint={up} bare />
          </li>
        ))}
      </ul>
      {more.length > 0 && (
        <details class="usage-more" data-testid="grammar-usage-more">
          <summary class="usage-more__toggle">
            More difficult cases ({more.length})
          </summary>
          <ul class="usage-list">
            {more.map((up) => (
              <li>
                <GrammarUsagePointCard usagePoint={up} bare />
              </li>
            ))}
          </ul>
        </details>
      )}
    </GrammarSection>
  )
}

<style>
  .usage-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .usage-more__toggle {
    display: inline-block;
    margin-bottom: 1rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-brand-strong);
  }
  .usage-more__toggle::-webkit-details-marker {
    display: none;
  }
  .usage-more[open] > .usage-more__toggle {
    display: none;
  }
</style>
