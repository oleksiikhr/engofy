---
import { usageActionsHtml } from '../../lib/grammar-usage-actions';
import type {
  GrammarConstructionUsagePoint,
  GrammarLevelProgress,
} from '../../lib/types';

interface Props {
  usagePoints: GrammarConstructionUsagePoint[];
  levelProgress?: GrammarLevelProgress[];
}

const { usagePoints, levelProgress } = Astro.props;
---

<section class="usage" data-testid="grammar-usage">
  <h2>When it's used</h2>
  {
    levelProgress && levelProgress.length > 0 && (
      <ul class="usage-progress" data-testid="grammar-level-progress">
        {levelProgress.map((level) => (
          <li data-level={level.cefrLevel}>
            <span class="badge">{level.cefrLevel}</span>
            <span>
              {level.learnedCount}/{level.totalCount} learned
            </span>
          </li>
        ))}
      </ul>
    )
  }
  {
    usagePoints.length === 0 && (
      <p>No usage points recorded for this construction.</p>
    )
  }
  <ul class="usage-list">
    {
      usagePoints.map((up) => (
        <li class="usage-item card" data-state={up.state}>
          <div class="usage-item__head">
            <span class="badge">{up.cefrLevel}</span>
            <span class="usage-item__guide">{up.guideword}</span>
          </div>
          <p class="usage-item__can">{up.explanation ?? up.canDoStatement}</p>
          {up.explanation && (
            <p class="usage-item__cando">{up.canDoStatement}</p>
          )}
          {up.examples.length > 0 && (
            <ul class="usage-item__examples" data-testid="usage-examples">
              {up.examples.map((example) => (
                <li>{example}</li>
              ))}
            </ul>
          )}
          <Fragment
            set:html={usageActionsHtml(
              up.grammarUsagePointId,
              up.state,
              undefined,
              up.assumedKnown,
            )}
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .usage h2 {
    margin: 0 0 0.75rem;
    font-size: 1.19rem;
    font-weight: 800;
  }
  .usage-progress {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-ink-soft);
  }
  .usage-progress li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .usage-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .usage-item {
    padding: 1.125rem 1.25rem;
  }
  .usage-item[data-state='learning'] {
    border-color: var(--color-brand);
  }
  .usage-item[data-state='learned'] {
    border-color: var(--color-success);
  }
  .usage-item[data-state='skipped'] {
    border-color: var(--color-warning);
  }
  .usage-item__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .usage-item__guide {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .usage-item__can {
    margin: 0 0 0.5rem;
    font-weight: 800;
  }
  .usage-item__cando {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--color-ink-faint);
  }
  .usage-item__examples {
    margin: 0 0 0.75rem;
    padding-left: 1.25rem;
    color: var(--color-ink-soft);
    font-style: italic;
  }
</style>

<!-- The action row is injected via set:html (shared with the HTMX partial),
     so its selectors must be global. -->
<style is:global>
  .gup-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .gup-actions form {
    margin: 0;
  }
  .gup-state {
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--color-paper-soft);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-ink-soft);
  }
  .gup-state--learning {
    background: var(--color-brand-wash);
    color: var(--color-brand-strong);
  }
  .gup-state--learned {
    background: var(--color-success-wash);
    color: var(--color-success-ink);
  }
  .gup-state--assumed {
    background: var(--color-paper-soft);
    color: var(--color-ink-faint);
  }
  .gup-state--skipped {
    background: var(--color-warning-wash);
    color: var(--color-warning-ink);
  }
</style>
