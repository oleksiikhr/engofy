---
// Daily-goal progress ring for the header. `pathLength="100"` lets the arc be
// a plain percentage. Guest rings are filled in client-side (lib/guest-header).
interface Props {
  done?: number;
  goal?: number;
  guest?: boolean;
}

const { done = 0, goal = 1, guest = false } = Astro.props;
const percent = Math.min(100, Math.round((done / Math.max(goal, 1)) * 100));
const label = `${done} of ${goal} cards today`;
---

<span
  class:list={['goal', { 'goal--done': !guest && done >= goal }]}
  title={label}
  data-testid="goal-ring"
  data-goal-done={guest ? undefined : String(done)}
  data-goal-target={guest ? undefined : String(goal)}
  data-goal-guest={guest ? '' : undefined}
  role="img"
  aria-label={label}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle class="goal__track" cx="12" cy="12" r="9" pathLength="100" />
    <circle
      class="goal__arc"
      cx="12"
      cy="12"
      r="9"
      pathLength="100"
      stroke-dasharray={`${percent} 100`}
    />
    <path class="goal__check" d="M8 12.5l3 3 5-6" />
  </svg>
</span>
