---
import type { CurrentUser } from '../lib/types';

interface Props {
  user?: CurrentUser | null;
  active?: string;
  streak?: number;
}

const { user = null, active, streak = 0 } = Astro.props;

const links = [
  { href: '/', label: 'Today', key: 'today', authOnly: false },
  { href: '/posts', label: 'Posts', key: 'posts', authOnly: false },
  { href: '/practice', label: 'Practice', key: 'practice', authOnly: true },
  { href: '/grammar', label: 'Grammar', key: 'grammar', authOnly: false },
  { href: '/dictionary', label: 'Dictionary', key: 'dictionary', authOnly: false },
  { href: '/profile', label: 'Profile', key: 'profile', authOnly: true },
].filter((link) => user || !link.authOnly);
---

<header class="site-header">
  <nav>
    <div class="nav-links">
      <a href="/" style="font-family: var(--font-display); font-weight: 700;">Engofy</a>
      {
        links.map((link) => (
          <a href={link.href} aria-current={active === link.key ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="nav-links">
      {
        user && streak > 0 && (
          <span class="streak" title={`${streak}-day review streak`}>
            🔥 {streak}
          </span>
        )
      }
      <a href="/pricing" aria-current={active === 'pricing' ? 'page' : undefined}>
        Pricing
      </a>
      {
        user ? (
          <form method="post" action="/logout" style="margin: 0;">
            <button class="btn btn--ghost" type="submit">Log out</button>
          </form>
        ) : (
          <a class="btn btn--ghost" href="/login">Log in</a>
        )
      }
    </div>
  </nav>
</header>

<style>
  .streak {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
</style>
