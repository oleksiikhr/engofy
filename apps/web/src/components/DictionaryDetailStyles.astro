---
// Shared styles for the /dictionary/words/[lemma] and
// /dictionary/phrases/[phrase] detail pages, whose markup comes from
// lib/dictionary-detail.ts (injected via set:html, hence global).
---

<style is:global>
  .crumb {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 700;
  }
  .wd-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-bottom: 1.5rem;
  }
  .wd-head h1 {
    margin: 0;
    font-size: 2.625rem;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .wd-head__rank {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink-faint);
  }
  #wd-detail h2,
  #pd-detail h2 {
    margin: 0 0 0.75rem;
    font-size: 1.19rem;
    font-weight: 800;
  }
  #wd-detail h3,
  #pd-detail h3 {
    margin: 1rem 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .wd-senses,
  .wd-irregular,
  .wd-posts {
    margin-bottom: 2rem;
  }
  .wd-sense-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1.25rem;
  }
  .wd-sense {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .wd-sense__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .wd-sense__phonetic,
  .wd-sense__def,
  .wd-sense__eg {
    margin: 0;
  }
  .wd-sense__phonetic {
    font-weight: 700;
    color: var(--color-ink-faint);
  }
  .wd-sense__def {
    font-weight: 600;
  }
  .wd-sense__eg {
    color: var(--color-ink-soft);
    font-style: italic;
  }
  .wd-sense__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .wd-sense__actions form {
    display: inline;
  }
  .wd-irregular p {
    margin: 0 0 0.25rem;
    color: var(--color-ink-soft);
  }
  .wd-posts__empty {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }
  .wd-posts__list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 0.5rem;
  }
  .wd-posts__list li {
    padding: 0.625rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.875rem;
    background: var(--color-card);
    font-weight: 700;
  }
  .wd-posts__list a {
    text-decoration: none;
  }
</style>
