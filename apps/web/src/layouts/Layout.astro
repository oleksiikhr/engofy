---
import SiteHeader from '../components/SiteHeader.astro';
import { apiGetOrNull } from '../lib/api';
import type { CurrentUser, StreakResponse } from '../lib/types';
import '../styles/app.css';

interface Props {
  title?: string;
  description?: string;
  user?: CurrentUser | null;
  active?: string;
  measure?: boolean;
}

const {
  title = 'Engofy',
  description = 'Learn English through short authentic texts.',
  user = null,
  active,
  measure = false,
} = Astro.props;

// Day streak in the header (PLAN.md §16/§17 Track B) — every page, not just
// the reader, so it stays a stable "you're on a streak" signal rather than
// something the reader has to re-establish per article.
const streak = user
  ? ((
      await apiGetOrNull<StreakResponse>('/learning/streak', {
        request: Astro.request,
      })
    )?.streak ?? 0)
  : 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader user={user} active={active} streak={streak} />
    <main class:list={['site-main', { 'reading-measure': measure }]}>
      <slot />
    </main>
    <script>
      // The npm ESM build doesn't self-assign window.htmx (unlike the CDN
      // script build). Pages call window.htmx.process(...) after injecting
      // markup client-side (reader tooltip, etc.).
      import htmx from 'htmx.org';
      window.htmx = htmx;
    </script>
  </body>
</html>
