---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { apiGetOrNull } from '../lib/api';
import { bootScript } from '../lib/prefs';
import { publicOrigin } from '../lib/site';
import type {
  CurrentUser,
  DueCardCountResponse,
  StreakResponse,
} from '../lib/types';
import '../styles/app.css';

interface Props {
  title?: string;
  description?: string;
  user?: CurrentUser | null;
  active?: string;
  measure?: boolean;
  // Keeps the page out of the index (private or transient pages).
  noindex?: boolean;
  ogType?: 'website' | 'article';
  // Absolute or root-relative URL of the share image; the site default when omitted.
  ogImage?: string;
}

const {
  title = 'Engofy',
  description = 'Learn English through short authentic texts.',
  user = null,
  active,
  measure = false,
  noindex = false,
  ogType = 'website',
  ogImage = '/og-default.png',
} = Astro.props;

const origin = publicOrigin(Astro.url);
// Query strings (`?from=home`, filters, cursors) never make a distinct page.
const canonical = `${origin}${Astro.url.pathname}`;
const ogImageUrl = new URL(ogImage, `${origin}/`).href;

// Day streak and Practice due-count in the header — every page, not just the
// reader, so they stay stable "you're on a streak / cards are waiting" signals
// rather than something each page has to re-establish.
const [streakResponse, dueResponse] = user
  ? await Promise.all([
      apiGetOrNull<StreakResponse>('/learning/streak', {
        request: Astro.request,
      }),
      apiGetOrNull<DueCardCountResponse>('/learning/due-count', {
        request: Astro.request,
      }),
    ])
  : [null, null];
const streak = streakResponse?.streak ?? 0;
const dueCount = dueResponse?.dueCount ?? 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="Engofy" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32 48x48" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#fff8ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1611" media="(prefers-color-scheme: dark)" />
    <!-- Stored display prefs (theme, reader size, ...) onto <html> before first paint. -->
    <script is:inline set:html={bootScript()} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body data-signed-in={user ? 'true' : undefined}>
    <SiteHeader user={user} active={active} streak={streak} dueCount={dueCount} />
    <main class:list={['site-main', { 'reading-measure': measure }]}>
      <slot />
    </main>
    <SiteFooter active={active} />
    <script>
      // The npm ESM build doesn't self-assign window.htmx (unlike the CDN
      // script build). Pages call window.htmx.process(...) after injecting
      // markup client-side (reader tooltip, etc.).
      import htmx from 'htmx.org';
      window.htmx = htmx;
    </script>
    <script>
      // Cards saved as a guest move into the account on the first signed-in
      // page load.
      import { importGuestDeck } from '../lib/guest-deck';

      if (document.body.dataset.signedIn === 'true') {
        importGuestDeck();
      }
    </script>
  </body>
</html>
