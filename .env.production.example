# engofy — production environment matrix (DigitalOcean App Platform)
# -----------------------------------------------------------------------------
# Not read by anything: a checklist of the env vars to set on the App Platform
# components (see docs/deploy.md for which component gets what). Values marked
# SECRET are entered as encrypted env vars in the DO control panel / app spec,
# never committed. Each var notes the source file that reads it.
# =============================================================================

# --- Release ----------------------------------------------------------------
# Shown on Sentry issues. Match it to the image tag. (src/core/observability/sentry.ts)
SENTRY_RELEASE=

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8080                       # web (Nest). apps-web listens on 4321.

# --- Public URL / CORS ------------------------------------------------------
# REQUIRED in production — main.ts throws without it. Also the single allowed
# CORS origin. One host, no subdomains (keeps __Host-session valid).
# (src/core/config/app.config.ts, src/main.ts)
PUBLIC_URL=https://engofy.com

# --- Client IP (web) --------------------------------------------------------
# Header that carries the real visitor address; Cloudflare sets it on every
# request. Throttler and per-IP OTP counters read it. Set ONLY when all traffic
# passes through Cloudflare. Leave TRUST_PROXY unset (hop counts are rejected).
# (src/core/helpers/client-ip.helper.ts)
CLIENT_IP_HEADER=cf-connecting-ip

# --- Postgres (DigitalOcean Managed) ----------------------------------------
# web, worker, cron and the migrate job all read these. (src/core/database/mikro-orm.setup.ts)
MIKRO_ORM_HOST=
MIKRO_ORM_PORT=25060
MIKRO_ORM_USER=
MIKRO_ORM_DB_NAME=
# MIKRO_ORM_PASSWORD is a SECRET.
# Managed Postgres requires TLS; the CA certificate (PEM) is a SECRET-like value
# copied from the database's panel.
DB_SSL=true
DB_SSL_CA=
# pg-boss and the advisory lock need a direct (session) connection. Set these
# only if MIKRO_ORM_HOST/PORT point at a connection pooler. (src/core/queue/config/queue.config.ts)
#QUEUE_DB_HOST=
#QUEUE_DB_PORT=

# --- Connection budget ------------------------------------------------------
# Cheapest Postgres plan = 22 connections. Per process: DB_POOL_MAX (MikroORM)
# + QUEUE_POOL_MAX (pg-boss); cron also takes 1 for the Telegram poll lock, and
# the migrate job 1-2 while it runs. See docs/deploy.md for the table.
#   web:    DB_POOL_MAX=5  QUEUE_POOL_MAX=2
#   worker: DB_POOL_MAX=4  QUEUE_POOL_MAX=3
#   cron:   DB_POOL_MAX=2  QUEUE_POOL_MAX=2
DB_POOL_MAX=5
QUEUE_POOL_MAX=2
# How long a worker waits for in-flight jobs on SIGTERM (an AI stage runs ~2 min).
# Must stay below the component's termination grace period (180 s in the app spec).
QUEUE_SHUTDOWN_TIMEOUT_MS=120000

# --- Redis ---------------------------------------------------------
# Throttler + OTP counters only; losing the data resets rate-limit windows.
# (src/core/redis/redis.config.ts)
# Internal App Platform service: no password, no TLS.
REDIS_HOST=redis
REDIS_PORT=6379

# --- NLP service ------------------------------------------------------------
# Internal App Platform component, no public route. (src/core/nlp/nlp.config.ts)
NLP_SERVICE_URL=http://nlp:8000

# --- apps-web ---------------------------------------------------------------
# Nest origin the Astro server calls. (apps/web/src/lib/api.ts)
API_ORIGIN=http://web:8080
# Public OAuth client id (safe to expose); shared with GOOGLE_CLIENT_ID below.
PUBLIC_GOOGLE_CLIENT_ID=

# --- Logging / observability ------------------------------------------------
# fatal|error|warn|info|debug|trace  (src/core/logger/logger.config.ts)
LOG_LEVEL=info
# SENTRY_DSN is a SECRET.
SENTRY_DEBUG=false
#SENTRY_TRACES_SAMPLE_RATE_WEB=0.1   # per-entrypoint override, default 0.1 in prod (src/core/observability/sentry.ts)

# --- Mail — Resend ----------------------------------------------------------
# RESEND_API_KEY is a SECRET. Without it the mailer refuses to boot in production.
# Do NOT set MAIL_USE_MAILHOG in prod. (src/core/mail/mail.config.ts)
MAIL_FROM_EMAIL=Engofy <onboarding@engofy.com>

# --- AI ---------------------------------------------------------------------
# ANTHROPIC_API_KEY is a SECRET. (src/core/ai/*.config.ts)
AI_MODEL=claude-sonnet-5

# --- Auth / Google sign-in --------------------------------------------------
# Leave blank to disable Google sign-in. (src/modules/auth/config/auth.config.ts)
GOOGLE_CLIENT_ID=

# --- Telegram admin bot -----------------------------------------------------
# TELEGRAM_BOT_TOKEN is a SECRET. Both crons no-op while it is unset.
# (src/modules/telegram/config/*.ts)
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_CHANNEL_ID=

# --- Optional tuning (defaults are sane) ------------------------------------
#DB_STATEMENT_TIMEOUT_MS=30000
#THROTTLE_TTL_MS=60000          # (src/core/config/throttler.config.ts)
#THROTTLE_LIMIT=300
#NLP_SERVICE_TIMEOUT_MS=30000   # (src/core/nlp/nlp.config.ts)
#AUTH_SESSION_TTL_MS=2592000000
#TELEGRAM_STUCK_POST_MINUTES=15 # (src/modules/telegram/config/telegram.config.ts)

# --- SECRETS (encrypted env vars) -------------------------------------------
# MIKRO_ORM_PASSWORD, ANTHROPIC_API_KEY, RESEND_API_KEY,
# TELEGRAM_BOT_TOKEN, SENTRY_DSN
