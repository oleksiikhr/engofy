# engofy — production environment matrix
# -----------------------------------------------------------------------------
# Copy to infra/.env.production and fill in. That file is git-ignored and is
# read by `docker stack deploy -c infra/stack.prod.yaml` (the CLI merges it
# into every service's environment).
#
# THREE kinds of configuration:
#   1. Non-secret site config      -> this file (infra/.env.production)
#   2. Credentials                  -> `docker secret create` (NEVER in a file
#                                      that gets committed; see the SECRETS
#                                      block at the bottom)
#   3. Fixed topology (hostnames,   -> already hard-set in stack.prod.yaml
#      ports, pool sizes)              `environment:` — listed here FYI only
#
# Each var notes the source file that reads it.
# =============================================================================

# --- Release --------------------------------------------------------------------
# Image tag the stack pulls: ghcr.io/oleksiikhr/engofy{,-web,-nlp}:${IMAGE_TAG}
# CI sets this to the commit SHA; `latest` also works. (infra/stack.prod.yaml)
IMAGE_TAG=latest
# Shown on Sentry issues. Match it to IMAGE_TAG. (src/core/observability/sentry.ts)
SENTRY_RELEASE=

# --- Public URL / CORS --------------------------------------------------------
# REQUIRED in production — main.ts throws without it. Also the single allowed
# CORS origin. One host, no subdomains (keeps __Host-session valid).
# (src/core/config/app.config.ts, src/main.ts)
PUBLIC_URL=https://engofy.com

# --- Logging / observability ------------------------------------------------
# fatal|error|warn|info|debug|trace  (src/core/logger/logger.config.ts)
LOG_LEVEL=info
# SENTRY_DSN is a SECRET (see bottom). These are safe knobs:
SENTRY_DEBUG=false
# Per-entrypoint trace sample override (default 0.1 in prod). stack.prod.yaml
# already sets SENTRY_TRACES_SAMPLE_RATE_{WEB,WORKER,CRON}=0.1 — override here
# only if you want a different rate. (src/core/observability/sentry.ts)
#SENTRY_TRACES_SAMPLE_RATE_WEB=0.1

# --- Object storage --------------------------------------------------------
# None. The app stores no assets (the pipeline is text-only). `infra/pg-backup.sh`
# talks to Cloudflare R2 directly via aws-cli — its creds live in that cron's
# EnvironmentFile, not here.

# --- Mail — Resend --------------------------------------------------------------
# RESEND_API_KEY is a SECRET (see bottom). Without it (and without an explicit
# MailHog opt-in) the mailer refuses to boot in production. Do NOT set
# MAIL_USE_MAILHOG in prod. (src/core/mail/mail.config.ts, mailer.provider.ts)
MAIL_FROM_EMAIL=Engofy <onboarding@engofy.com>

# --- AI ----------------------------------------------------------------------
# ANTHROPIC_API_KEY is a SECRET (see bottom).
# (src/core/ai/*.config.ts)
AI_MODEL=claude-sonnet-5

# --- Auth / Google sign-in --------------------------------------------------
# Public OAuth client id (safe to expose). Backend token verification +
# frontend button. Leave blank to disable Google sign-in.
# (src/modules/auth/config/auth.config.ts ; apps/web PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
PUBLIC_GOOGLE_CLIENT_ID=

# --- Telegram admin bot ----------------------------------------------------
# TELEGRAM_BOT_TOKEN is a SECRET (see bottom). Both crons no-op while the token
# is unset. (src/modules/telegram/config/*.ts)
# Numeric user id the poll cron acts on:
TELEGRAM_ADMIN_USER_ID=
# Channel/chat the publish cron announces to ("@engofy" or "-100123...").
TELEGRAM_CHANNEL_ID=

# --- Optional tuning (defaults are sane; uncomment to change) --------------
#DB_POOL_MAX=10                 # per Nest process (src/core/database/mikro-orm.setup.ts)
#QUEUE_POOL_MAX=5               # per Nest process (src/core/queue/config/queue.config.ts)
#DB_STATEMENT_TIMEOUT_MS=30000
#THROTTLE_TTL_MS=60000          # (src/core/config/throttler.config.ts)
#THROTTLE_LIMIT=300
#NLP_SERVICE_TIMEOUT_MS=30000   # (src/core/nlp/nlp.config.ts)
#AUTH_SESSION_TTL_MS=2592000000
#TELEGRAM_STUCK_POST_MINUTES=15  # idle minutes before a processing post alerts the admin (src/modules/telegram/config/telegram.config.ts)

# =============================================================================
# SECRETS — create these on the swarm, do NOT put them in this file.
# The names on the left are the swarm secret names; stack.prod.yaml mounts each
# with a `target:` and docker-entrypoint.sh turns the target into the env var
# shown in the arrow.
#
#   printf %s "$VALUE" | docker secret create <name> -
#
#   engofy_db_password            -> MIKRO_ORM_PASSWORD  (+ postgres POSTGRES_PASSWORD_FILE)
#   engofy_anthropic_api_key      -> ANTHROPIC_API_KEY
#   engofy_resend_api_key         -> RESEND_API_KEY
#   engofy_telegram_bot_token     -> TELEGRAM_BOT_TOKEN
#   engofy_sentry_dsn             -> SENTRY_DSN
#   engofy_cloudflared_credentials-> mounted at /etc/cloudflared/credentials.json
#
# Plus one Docker CONFIG (not a secret):
#   engofy_cloudflared_config  <- infra/cloudflared/config.yml
#
# =============================================================================
# FIXED TOPOLOGY — already set in stack.prod.yaml, here for reference only:
#   NODE_ENV=production  HOST=0.0.0.0  PORT=8080  TRUST_PROXY=1
#   MIKRO_ORM_HOST=postgres  MIKRO_ORM_PORT=5432  MIKRO_ORM_USER=engofy  MIKRO_ORM_DB_NAME=engofy
#   REDIS_HOST=redis  REDIS_PORT=6379
#   NLP_SERVICE_URL=http://nlp:8000
#   API_ORIGIN=http://web:8080   (apps-web)
# =============================================================================
