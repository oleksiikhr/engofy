{
  "name": "engofy",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "nest build --type-check",
    "dev": "NODE_ENV=development nest start --type-check",
    "watch": "NODE_ENV=development nest start --type-check --watch",
    "debug": "NODE_ENV=development nest start --debug",
    "prod": "NODE_ENV=production node dist/main",
    "cli": "NODE_ENV=development node --import @swc-node/register/esm-register src/cli.ts",
    "cli:debug": "NODE_ENV=development node --inspect --import @swc-node/register/esm-register src/cli.ts",
    "worker": "NODE_ENV=development node --import @swc-node/register/esm-register src/worker.ts",
    "worker:debug": "NODE_ENV=development node --inspect --import @swc-node/register/esm-register src/worker.ts",
    "cron": "NODE_ENV=development node --import @swc-node/register/esm-register src/cron.ts",
    "cron:debug": "NODE_ENV=development node --inspect --import @swc-node/register/esm-register src/cron.ts",
    "mikro-orm": "node --import @swc-node/register/esm-register node_modules/@mikro-orm/cli/cli.js",
    "migration:create": "pnpm mikro-orm migration:create",
    "migration:up": "pnpm mikro-orm migration:up",
    "migration:down": "pnpm mikro-orm migration:down",
    "migration:check": "pnpm mikro-orm migration:check",
    "type": "tsc --noEmit",
    "lint": "biome check --write --unsafe",
    "lint:check": "biome check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^10.1.3",
    "@mikro-orm/core": "^7.1.11",
    "@mikro-orm/decorators": "^7.1.11",
    "@mikro-orm/migrations": "^7.1.11",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.1.11",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/nestjs": "^10.69.0",
    "@sentry/opentelemetry": "^10.69.0",
    "fastify": "5.10.0",
    "google-auth-library": "^11.0.0",
    "image-size": "^2.0.2",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "marked": "^18.0.9",
    "mime-types": "^3.0.2",
    "nest-commander": "^3.20.1",
    "nestjs-otel": "^8.1.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "node-html-parser": "^9.0.1",
    "nodemailer": "^9.0.5",
    "pg-boss": "^12.27.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.1",
    "rxjs": "^7.8.2",
    "ts-fsrs": "^5.4.1",
    "undici": "^8.10.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@mikro-orm/cli": "^7.1.11",
    "@mikro-orm/seeder": "^7.1.11",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/luxon": "^3.7.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "pino-pretty": "^13.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/core/database/mikro-orm.setup.ts"
    ]
  }
}
