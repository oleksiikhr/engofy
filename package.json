{
  "name": "engofy",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "nest build --type-check",
    "dev": "NODE_ENV=development nest start --type-check",
    "watch": "NODE_ENV=development nest start --type-check --watch",
    "debug": "NODE_ENV=development nest start --debug",
    "prod": "NODE_ENV=production node dist/main",
    "cli": "NODE_ENV=development node --import @swc-node/register/esm-register src/cli.ts",
    "cli:debug": "NODE_ENV=development node --inspect --import @swc-node/register/esm-register src/cli.ts",
    "worker": "NODE_ENV=development node --import @swc-node/register/esm-register src/worker.ts",
    "worker:debug": "NODE_ENV=development node --inspect --import @swc-node/register/esm-register src/worker.ts",
    "cron": "NODE_ENV=development node --import @swc-node/register/esm-register src/cron.ts",
    "cron:debug": "NODE_ENV=development node --inspect --import @swc-node/register/esm-register src/cron.ts",
    "type": "tsc --noEmit",
    "lint": "biome check --write --unsafe",
    "lint:check": "biome check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^9.1.3",
    "@mikro-orm/core": "^7.1.5",
    "@mikro-orm/decorators": "^7.1.5",
    "@mikro-orm/migrations": "^7.1.5",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.1.5",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/terminus": "^11.1.1",
    "@sentry/nestjs": "^10.63.0",
    "@sentry/opentelemetry": "^10.63.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "5.8.5",
    "image-size": "^2.0.2",
    "luxon": "^3.7.2",
    "mime-types": "^3.0.2",
    "nest-commander": "^3.20.1",
    "nestjs-otel": "^8.1.0",
    "nestjs-pino": "^4.6.1",
    "pg-boss": "^12.26.4",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^8.6.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@faker-js/faker": "^10.5.0",
    "@mikro-orm/cli": "^7.1.5",
    "@mikro-orm/seeder": "^7.1.5",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@swc-node/register": "^1.11.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@types/luxon": "^3.7.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.13.2",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "pino-pretty": "^13.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/core/database/mikro-orm-config.helper.ts"
    ]
  }
}
